# Users Database (Auth Service - Port 5432)
USERS_DB_USER=user
USERS_DB_PASSWORD=password
USERS_DB_NAME=users

# Lootlog Database (API Service - Port 5433)
LOOTLOG_DB_USER=user
LOOTLOG_DB_PASSWORD=password
LOOTLOG_DB_NAME=lootlog
POSTGRESQL_CONNECTION_URI=postgresql://user:password@localhost:5433/lootlog

# Battle Log Database (Battlelog Service - Port 5434)
BATTLE_LOG_DB_USER=user
BATTLE_LOG_DB_PASSWORD=password
BATTLE_LOG_DB_NAME=battle_log

# Activity Database (Activity Service - Port 5435)
ACTIVITY_LOG_DB_USER=user
ACTIVITY_LOG_DB_PASSWORD=password
ACTIVITY_LOG_DB_NAME=activity_log

# Notifications Database (Notifications Service - Port 5436)
NOTIFICATIONS_DB_USER=user
NOTIFICATIONS_DB_PASSWORD=password
NOTIFICATIONS_DB_NAME=notifications
NOTIFICATIONS_POSTGRESQL_CONNECTION_URI=postgresql://user:password@localhost:5436/notifications

# RabbitMQ Message Queue
RABBITMQ_DEFAULT_USER=rabbitmq_user
RABBITMQ_DEFAULT_PASS=rabbitmq_password

# Meilisearch
MEILISEARCH_MASTER_KEY=meilisearch_master_key

# Redis Cache
REDIS_PASSWORD=redis_password

# Development Settings (for seeding)
# Multiple guild IDs can be provided separated by commas
# Example: DISCORD_DEVELOPMENT_GUILD_ID=123456789,987654321,555555555
DISCORD_DEVELOPMENT_GUILD_ID=xxx
DISCORD_DEVELOPMENT_USER_ID=xxx
SEEDING_USER_ID=xxx
