{
  "name": "@lootlog/hono-shared",
  "version": "0.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "permissions": [
        "./dist/permissions.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./permissions": {
      "types": "./dist/permissions.d.ts",
      "default": "./dist/permissions.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@hono/otel": "^1.1.1",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.3.0",
    "hono": "^4.12.14",
    "jose": "^6.2.2"
  },
  "devDependencies": {
    "@lootlog/typescript-config": "workspace:*",
    "@types/node": "^25.6.0"
  }
}
