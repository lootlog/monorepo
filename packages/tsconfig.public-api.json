// Declaration build for the published packages (`sdk`, `game-client-api`).
// It lives in `packages/` on purpose: the declaration bundler uses this file's
// directory as `rootDir`, so it must be a common ancestor of every workspace
// whose sources the published types include.
{
  "extends": "./sdk/tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@lootlog/client/*": ["./client/src/*"],
      "@lootlog/protocol/realtime": ["./protocol/src/realtime/protocol.ts"],
      "@lootlog/protocol/*": ["./protocol/src/*"],
      "@lootlog/schema/*": ["./schema/src/*"]
    },
    "types": []
  },
  "include": [
    "sdk/src",
    "client/src/realtime/index.ts",
    "client/src/transport.ts",
    "game-client-api/src"
  ]
}
