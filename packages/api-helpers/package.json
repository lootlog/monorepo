{
  "name": "@lootlog/api-helpers",
  "version": "1.0.2",
  "private": true,
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "typesVersions": {
    "*": {
      "auth/user-metadata": [
        "./dist/auth/user-metadata.d.ts"
      ],
      "auth/verify-jwt": [
        "./dist/auth/verify-jwt.d.ts"
      ],
      "permissions": [
        "./dist/permissions.d.ts"
      ]
    }
  },
  "exports": {
    "./auth/user-metadata": {
      "types": "./dist/auth/user-metadata.d.ts",
      "import": "./dist/auth/user-metadata.mjs",
      "require": "./dist/auth/user-metadata.js"
    },
    "./auth/verify-jwt": {
      "types": "./dist/auth/verify-jwt.d.ts",
      "import": "./dist/auth/verify-jwt.mjs",
      "require": "./dist/auth/verify-jwt.js"
    },
    "./permissions": {
      "types": "./dist/permissions.d.ts",
      "import": "./dist/permissions.mjs",
      "require": "./dist/permissions.js"
    }
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "hono": "^4.12.34",
    "jose": "^6.2.4"
  },
  "devDependencies": {
    "@lootlog/typescript-config": "workspace:*",
    "tsdown": "catalog:"
  }
}
