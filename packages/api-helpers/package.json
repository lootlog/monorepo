{
  "name": "@lootlog/api-helpers",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "permissions": [
        "./dist/permissions.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./permissions": {
      "types": "./dist/permissions.d.ts",
      "import": "./dist/permissions.mjs",
      "require": "./dist/permissions.js"
    }
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "hono": "^4.12.14",
    "jose": "^6.2.2"
  },
  "devDependencies": {
    "@lootlog/typescript-config": "workspace:*",
    "tsdown": "^0.22.2"
  }
}
