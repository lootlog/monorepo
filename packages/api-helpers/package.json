{
  "name": "@lootlog/api-helpers",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "typesVersions": {
    "*": {
      "auth/verify-jwt": [
        "./dist/auth/verify-jwt.d.ts"
      ],
      "permissions": [
        "./dist/permissions.d.ts"
      ]
    }
  },
  "exports": {
    "./auth/verify-jwt": {
      "types": "./dist/auth/verify-jwt.d.ts",
      "import": "./dist/auth/verify-jwt.mjs",
      "require": "./dist/auth/verify-jwt.js"
    },
    "./permissions": {
      "types": "./dist/permissions.d.ts",
      "import": "./dist/permissions.mjs",
      "require": "./dist/permissions.js"
    }
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "jose": "^6.2.2"
  },
  "devDependencies": {
    "@lootlog/typescript-config": "workspace:*",
    "tsdown": "^0.21.9"
  }
}
