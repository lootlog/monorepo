{
  "name": "@lootlog/nest-shared",
  "version": "1.0.0",
  "private": true,
  "description": "Shared NestJS modules, services, and utilities for backend microservices",
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "default": "./dist/config/index.js"
    },
    "./decorators": {
      "types": "./dist/decorators/index.d.ts",
      "default": "./dist/decorators/index.js"
    },
    "./openapi": {
      "types": "./dist/openapi/openapi-document.d.ts",
      "default": "./dist/openapi/openapi-document.js"
    },
    "./redis": {
      "types": "./dist/redis/index.d.ts",
      "default": "./dist/redis/index.js"
    },
    "./validators/query-helpers": {
      "types": "./dist/validators/query-helpers.d.ts",
      "default": "./dist/validators/query-helpers.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@axiomhq/winston": "^1.6.1",
    "@lootlog/types": "workspace:*",
    "fastify": "^5.8.5",
    "js-yaml": "^4.3.0",
    "nest-winston": "^1.10.2",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nestjs/common": "^11.1.26",
    "@nestjs/core": "^11.1.26",
    "@types/node": "^25.6.0",
    "ioredis": "^5.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "ioredis": "^5.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.0.0"
  }
}
