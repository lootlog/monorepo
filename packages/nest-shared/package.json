{
  "name": "@lootlog/nest-shared",
  "version": "1.0.7",
  "private": true,
  "description": "Shared NestJS modules, services, and utilities for backend microservices",
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./app": {
      "types": "./dist/app/create-nest-fastify-app.d.ts",
      "default": "./dist/app/create-nest-fastify-app.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "default": "./dist/config/index.js"
    },
    "./decorators": {
      "types": "./dist/decorators/index.d.ts",
      "default": "./dist/decorators/index.js"
    },
    "./openapi": {
      "types": "./dist/openapi/openapi-document.d.ts",
      "default": "./dist/openapi/openapi-document.js"
    },
    "./redis": {
      "types": "./dist/redis/index.d.ts",
      "default": "./dist/redis/index.js"
    },
    "./rabbitmq": {
      "types": "./dist/rabbitmq/rabbitmq-retry.service.d.ts",
      "default": "./dist/rabbitmq/rabbitmq-retry.service.js"
    },
    "./utils/stable-stringify": {
      "types": "./dist/utils/stable-stringify.d.ts",
      "default": "./dist/utils/stable-stringify.js"
    },
    "./validators/query-helpers": {
      "types": "./dist/validators/query-helpers.d.ts",
      "default": "./dist/validators/query-helpers.js"
    }
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc",
    "test": "vitest run src"
  },
  "dependencies": {
    "@axiomhq/winston": "^1.8.0",
    "@lootlog/types": "workspace:*",
    "fastify": "^5.10.0",
    "js-yaml": "^5.2.2",
    "nest-winston": "catalog:",
    "winston": "^3.19.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-fastify": "catalog:",
    "@types/node": "catalog:",
    "ioredis": "^5.11.1",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "ioredis": "^5.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.0.0"
  }
}
