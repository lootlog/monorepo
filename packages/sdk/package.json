{
  "name": "@lootlog/sdk",
  "version": "0.1.0",
  "license": "MIT",
  "files": [
    "dist",
    "openapi",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./openapi/*.json": "./openapi/*.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./main": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    },
    "./activity": {
      "types": "./dist/activity.d.ts",
      "import": "./dist/activity.js"
    },
    "./battlelog": {
      "types": "./dist/battlelog.d.ts",
      "import": "./dist/battlelog.js"
    },
    "./search": {
      "types": "./dist/search.d.ts",
      "import": "./dist/search.js"
    },
    "./realtime": {
      "types": "./dist/realtime.d.ts",
      "import": "./dist/realtime.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src/*.ts scripts *.ts --deny-warnings",
    "test": "bun test",
    "prepack": "bun run build",
    "client:generate": "bun scripts/generate.ts",
    "client:check": "bun scripts/generate.ts --check",
    "test:package": "bun scripts/check-package.ts"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@lootlog/client": "workspace:*",
    "@lootlog/protocol": "workspace:*",
    "@lootlog/schema": "workspace:*",
    "@lootlog/typescript-config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "orval": "^8.26.0",
    "tsup": "^8.5.0",
    "typescript": "npm:typescript@5.9.3",
    "yaml": "catalog:"
  }
}
