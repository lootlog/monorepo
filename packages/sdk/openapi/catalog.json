        "security": [
          {
            "apiKey": []
          }
        ],
        "x-lootlog-access": "read",
        "x-lootlog-data": "public"
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Api-Key"
      }
    },
    "schemas": {
      "CatalogItemsResponseDto_Output": {
        "type": "object",
        "properties": {
          "hits": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CatalogItemDto_Output"
            }
          },
          "estimatedTotalHits": {
            "type": "number"
          }
        },
        "required": ["hits", "estimatedTotalHits"],
        "description": "Public catalog items"
      },
      "CatalogItemDto_Output": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "stat": {
            "type": "string"
          },
          "lvl": {
            "type": "number"
          },
          "rarity": {
            "nullable": true,
            "type": "string"
          },
          "type": {
            "nullable": true,
            "type": "string"
          },
          "droppedBy": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CatalogDropSourceDto_Output"
            }
          },
          "revisions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CatalogItemRevisionDto_Output"
            },
            "description": "The changes the game made to the item, oldest first, as Lootlog saw them in loots. Revisions looted side by side, as variants are, are no history and are left out. Lootlog recomputes them daily."
          },
          "elasticLevel": {
            "type": "boolean",
            "description": "Whether the item takes the level of the character who loots it, so `lvl` and `stat` describe one of its levels."
          }
        },
        "required": [
          "id",
          "name",
          "icon",
          "stat",
          "lvl",
          "rarity",
          "type",
          "droppedBy",
          "revisions",
          "elasticLevel"
        ],
        "description": "A Margonem item in the public catalog"
      },
      "CatalogDropSourceDto_Output": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "The NPC's catalog key, as `CatalogNpcDto_Output.key`."
          },
          "id": {
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "lvl": {
            "nullable": true,
            "type": "number"
          },
          "icon": {
            "nullable": true,
            "type": "string"
          },
          "type": {
            "nullable": true,
            "type": "string"
          },
          "retired": {
            "type": "boolean",
            "description": "Whether the NPC no longer drops the item: Lootlog has recorded its loot far too often since the item's last drop for the gap to be chance."
          },
          "dropRate": {
            "description": "How often the boss's kills drop the item, counted by the Organizations whose loot settings keep its rarity, from their hourly kill counts on. Lootlog recomputes it daily and gives none for other NPCs or under 100 such kills.",
            "nullable": true,
            "type": "object",
            "properties": {
              "drops": {
                "type": "number",
                "description": "Kills that dropped the item."
              },
              "kills": {
                "type": "number",
                "description": "Kills that could have recorded the drop."
              }
            },
            "required": ["drops", "kills"],
            "additionalProperties": false
          }
        },
        "required": [
          "key",
          "id",
          "name",
          "lvl",
          "icon",
          "type",
          "retired",
          "dropRate"
        ],
        "description": "An NPC an item drops from"
      },
      "CatalogItemRevisionDto_Output": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "lvl": {
            "type": "number",
            "description": "The level both revisions have; an elastic item's change is shown at one of its levels."
          },
          "stat": {
            "type": "string"
          },
          "previousName": {
            "type": "string"
          },
          "previousIcon": {
            "type": "string"
          },
          "previousStat": {
            "type": "string"
          },
          "changedAfter": {
            "type": "string",
            "description": "The day in Poland, as `YYYY-MM-DD`, the old revision was last looted: the game changed the item after it."
          },
          "changedBy": {
            "type": "string",
            "description": "The day in Poland, as `YYYY-MM-DD`, the new revision was first looted: the game changed the item by then."
          }
        },
        "required": [
          "name",
          "icon",
          "lvl",
          "stat",
          "previousName",
          "previousIcon",
          "previousStat",
          "changedAfter",
          "changedBy"
        ],
        "description": "A change the game made to an item"
      },
      "SearchUnavailableEncoded": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": ["SearchUnavailable"]
          },
          "message": {
            "type": "string"
          }
        },
        "required": ["_tag", "message"]
      },
      "CatalogNpcsResponseDto_Output": {
        "type": "object",
        "properties": {
          "hits": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CatalogNpcDto_Output"
            }
          },
          "estimatedTotalHits": {
            "type": "number"
          }
        },
        "required": ["hits", "estimatedTotalHits"],
        "description": "Public catalog NPCs"
      },
      "CatalogNpcDto_Output": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "Stable catalog key of the NPC, used to link its page."
          },
          "id": {
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "lvl": {
            "type": "number"
          },
          "prof": {
            "type": "string",
            "description": "The NPC's profession as Margonem writes it, such as `w`; empty for most monsters."
          },
          "type": {
            "type": "string",
            "enum": [
              "COMMON",
              "ELITE",
              "ELITE2",
              "ELITE3",
              "HERO",
              "EVENT_HERO",
              "COLOSSUS",
              "TITAN",
              "HERO_TRACKER",
              "NPC"
            ]
          },
          "gameVersion": {
            "type": "string",
            "enum": ["en", "pl"]
          },
          "locations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "map": {
                  "type": "string",
                  "description": "The map's name."
                },
                "share": {
                  "type": "number",
                  "description": "The share of the NPC's latest recorded fights on the map, from 0 to 1, rounded to a hundredth."
                }
              },
              "required": ["map", "share"]
            },
            "description": "Maps the NPC is fought on, most fought first, from its latest 1000 recorded fights; maps under 1% of them are left out. Lootlog recomputes them daily, so an NPC first seen today may have none yet."
          },
          "formerLevels": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "lvl": {
                  "type": "number",
                  "description": "The level it had."
                },
                "until": {
                  "type": "string",
                  "description": "The UTC day, as `YYYY-MM-DD`, its next level was first recorded."
                }
              },
              "required": ["lvl", "until"]
            },
            "description": "Levels the NPC had before the game changed it, oldest first. Lootlog recomputes them daily from recorded fights and leaves out NPCs whose level follows the player's."
          }
        },
        "required": [
          "key",
          "id",
          "name",
          "icon",
          "lvl",
          "prof",
          "type",
          "gameVersion",
          "locations",
          "formerLevels"
        ],
        "description": "A Margonem NPC in the public catalog"
      },
      "CatalogEventsResponseDto_Output": {
        "type": "object",
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CatalogEventDto_Output"
            },
            "description": "The latest year first, then by name."
          }
        },
        "required": ["events"],
        "description": "Public catalog events"
      },
