{
  "openapi": "3.0.0",
  "info": {
    "title": "Catalog API",
    "version": "1.0",
    "description": "Margonem items and NPCs as Lootlog observed them",
    "contact": {}
  },
  "servers": [
    {
      "url": "https://catalog.lootlog.pl"
    }
  ],
  "paths": {
    "/catalog/items": {
      "get": {
        "tags": ["Catalog"],
        "operationId": "CatalogController_getItems",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "required": false
          },
          {
            "name": "gameVersion",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["en", "pl"],
              "description": "Only entries of this game edition."
            },
            "required": false
          },
          {
            "name": "ids",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": false,
            "style": "form",
            "explode": true
          },
          {
            "name": "rarities",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "required": false,
            "style": "form",
            "explode": true
          },
          {
            "name": "types",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "required": false,
            "style": "form",
            "explode": true
          },
          {
            "name": "professions",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "required": false,
            "style": "form",
            "explode": true
          },
          {
            "name": "minLevel",
            "in": "query",
            "schema": {
              "type": "number"
            },
            "required": false
          },
          {
            "name": "maxLevel",
            "in": "query",
            "schema": {
              "type": "number"
            },
            "required": false
          },
          {
            "name": "statKeys",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "required": false,
            "style": "form",
            "explode": true
          },
          {
            "name": "excludedStatKeys",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "required": false,
            "style": "form",
            "explode": true
          },
          {
            "name": "legendaryBonuses",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "required": false,
            "style": "form",
            "explode": true
          },
          {
            "name": "dropSourceTypes",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "required": false,
            "style": "form",
            "explode": true
          },
          {
            "name": "event",
            "in": "query",
            "schema": {
              "type": "string",
              "description": "Items of the event with this slug: its name and year, such as `wakacje-2026`."
            },
            "required": false
          },
          {
            "name": "droppedBy",
            "in": "query",
            "schema": {
              "type": "string",
              "description": "Items that drop from the NPC with this catalog key."
            },
            "required": false
          },
          {
            "name": "availableSince",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Items a character on a world opened on this day (`YYYY-MM-DD`) can get: every item of no event, and event items of an edition that ended after it. Events end in the morning and worlds open later in the day, so an edition ending on the opening day is left out. An event without a year comes back, so its items stay."
            },
            "required": false
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "id:desc",
                "changedOn:desc",
                "lvl:asc",
                "lvl:desc",
                "name:asc",
                "name:desc",
                "attackSpeed:desc",
                "upgradedAttackSpeed:desc"
              ],
              "description": "`id:desc` lists the items Margonem added most recently first. `changedOn:desc` lists first the items the game changed most recently, by the day their latest revision was first looted; items without a change follow. `attackSpeed:desc` lists first the items that add the most attack speed to a character with at least 100 agility: their own attack speed plus 0.002 for each point of agility or all attributes. `upgradedAttackSpeed:desc` ranks the same attack speed with each item upgraded to +5 and given the +5 bonus that adds the most of it: attack speed on weapons, agility or all attributes on other pieces."
            },
            "required": false
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "number",
              "default": 24
            },
            "required": false
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "number",
              "default": 0
            },
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Public catalog items",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogItemsResponseDto_Output"
                }
              }
            }
          },
          "401": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string"
                        }
                      },
                      "required": ["message"]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string"
                        }
                      },
                      "required": ["message"]
                    }
                  ]
                }
              }
            }
          },
          "403": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": ["message"]
                }
              }
            }
          },
          "429": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": ["message"]
                }
              }
            }
          },
          "503": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchUnavailableEncoded"
                }
              }
            }
          }
        },
        "summary": "List items in the public catalog",
        "security": [
          {
            "apiKey": []
          }
        ],
        "x-lootlog-access": "read",
        "x-lootlog-data": "public"
      }
    },
    "/catalog/npcs": {
      "get": {
        "tags": ["Catalog"],
        "operationId": "CatalogController_getNpcs",
        "parameters": [
          {
