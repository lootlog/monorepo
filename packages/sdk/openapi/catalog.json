                }
              }
            }
          },
          "503": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchUnavailableEncoded"
                }
              }
            }
          }
        },
        "summary": "List NPCs in the public catalog",
        "security": [
          {
            "apiKey": []
          }
        ],
        "x-lootlog-access": "read",
        "x-lootlog-data": "public"
      }
    },
    "/catalog/events": {
      "get": {
        "tags": ["Catalog"],
        "operationId": "CatalogController_getEvents",
        "parameters": [
          {
            "name": "gameVersion",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["en", "pl"],
              "description": "Only entries of this game edition."
            },
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogEventsResponseDto_Output"
                }
              }
            }
          },
          "401": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string"
                        }
                      },
                      "required": ["message"]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string"
                        }
                      },
                      "required": ["message"]
                    }
                  ]
                }
              }
            }
          },
          "403": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
