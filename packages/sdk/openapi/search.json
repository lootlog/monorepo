{
  "openapi": "3.0.0",
  "info": {
    "title": "Search API",
    "version": "1.0",
    "description": "Player search",
    "contact": {}
  },
  "servers": [
    {
      "url": "https://search.lootlog.pl"
    }
  ],
  "paths": {
    "/players": {
      "get": {
        "tags": ["Players"],
        "operationId": "PlayersController_getPlayers",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "number",
              "default": 10
            },
            "required": false
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "required": false
          },
          {
            "name": "world",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "List of matching players",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PlayerHitDto_Output"
                  }
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestValidationError"
                }
              }
            }
          },
          "401": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpErrorResponse"
                }
              }
            }
          }
        },
        "summary": "Search players by name",
        "security": [
          {
            "apiKey": []
          }
        ],
        "x-lootlog-access": "read",
        "x-lootlog-data": "public"
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Api-Key"
      }
    },
    "schemas": {
      "PlayerHitDto_Output": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "lvl": {
            "type": "number"
          },
          "prof": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "characterId": {
            "type": "number"
          },
          "accountId": {
            "type": "number"
          },
          "world": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "lvl",
          "prof",
          "icon",
          "characterId",
          "accountId",
          "world"
        ],
        "description": "Player search hit"
      },
      "RequestValidationError": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": ["VALIDATION_ERROR"]
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "properties": {
              "issues": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "array",
                      "items": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "integer",
                            "minimum": -9007199254740991,
                            "maximum": 9007199254740991
                          }
                        ]
                      }
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": ["path", "message"]
                }
              }
            },
            "required": ["issues"]
          }
        },
        "required": ["code", "message", "details"]
      },
      "HttpErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "nullable": true,
            "type": "string"
          },
          "details": {
            "nullable": true,
            "type": "object"
          }
        },
        "required": ["code"]
      }
    }
  }
}
