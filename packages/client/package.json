{
  "name": "@lootlog/client",
  "version": "5.0.5",
  "private": true,
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#test/*": "./test/*.ts"
  },
  "exports": {
    "./activity": "./src/generated/activity.ts",
    "./auth": "./src/generated/auth.ts",
    "./battlelog": "./src/generated/battlelog.ts",
    "./catalog": "./src/generated/catalog.ts",
    "./main": "./src/generated/main.ts",
    "./realtime": "./src/realtime/index.ts",
    "./realtime/event-listeners": "./src/realtime/event-listeners.ts",
    "./search": "./src/generated/search.ts",
    "./transport": "./src/transport.ts"
  },
  "scripts": {
    "typecheck": "bun check",
    "lint": "oxlint src/*.ts src/realtime scripts orval.config.ts --deny-warnings",
    "test": "bun test",
    "client:check": "bun ./scripts/check-generated.ts",
    "client:generate": "bun ./scripts/generate.ts"
  },
  "dependencies": {
    "@lootlog/protocol": "workspace:*",
    "@lootlog/schema": "workspace:*"
  },
  "devDependencies": {
    "@lootlog/typescript-config": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "orval": "^8.42.0",
    "react": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.104.1",
    "react": "^19.3.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
