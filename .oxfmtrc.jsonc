{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "singleQuote": false,
  "trailingComma": "all",
  "ignorePatterns": [
    "tools/oxlint/anti-slop/**",
    ".agents/**",
    ".claude/**",
    "**/.claude/**",
    ".source/**",
    ".turbo/**",
    "build/**",
    "dist/**",
    "node_modules/**",
    "out/**",
    "repos/**",
    "**/routeTree.gen.ts",
    "apps/docs/wrangler.jsonc",
    "**/generated/**",
    "**/prisma/generated/**",
  ],
}
