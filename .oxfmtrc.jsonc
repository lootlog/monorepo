{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "singleQuote": false,
  "trailingComma": "all",
  "ignorePatterns": [
    ".agents/**",
    ".claude/**",
    "**/.claude/**",
    ".next/**",
    ".source/**",
    ".turbo/**",
    "build/**",
    "coverage/**",
    "dist/**",
    "apps/activity/migrations/**",
    "apps/api/migrations/**",
    "node_modules/**",
    "out/**",
    "pnpm-lock.yaml",
    "**/generated/**",
    "**/prisma/generated/**",
  ],
}
