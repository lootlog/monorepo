{
  "plugins": ["oxc", "typescript", "unicorn", "vitest"],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    ".codegraph/**",
    "repos/**",
    "tools/oxlint/anti-slop/**",
    "**/node_modules",
    "**/dist",
    "**/build",
    "**/coverage",
    "**/.source",
    "**/*.tsbuildinfo",
    ".agents/skills/**/scripts/**",
    "packages/client/src/generated/**",
    "packages/sdk/src/generated/**"
  ],
  "jsPlugins": [
    {
      "name": "anti-slop",
      "specifier": "./tools/oxlint/anti-slop/index.ts"
    },
    {
      "name": "anti-slop-effect",
      "specifier": "./tools/oxlint/anti-slop/effect/index.ts"
    },
    {
      "name": "lootlog-comments",
      "specifier": "./tools/oxlint/comments/index.ts"
    },
    {
      "name": "lootlog",
      "specifier": "./tools/oxlint/lootlog/index.ts"
    }
  ],
  "env": {
    "browser": true,
    "node": true,
    "es2021": true
  },
  "overrides": [
    {
      // Effect tagged-value policy applies only to workspaces that depend on `effect`.
      "files": [
        "apps/activity/**",
        "apps/api/**",
        "apps/auth/**",
        "apps/battlelog/**",
        "apps/discord-bot/**",
        "apps/gateway/**",
        "apps/search/**",
        "packages/cli/**",
        "packages/database/**",
        "packages/domain/**",
        "packages/instrumentation/**",
        "packages/messaging/**",
        "packages/protocol/**",
        "packages/schema/**",
        "packages/sdk/**"
      ],
      "rules": {
        "anti-slop-effect/no-manual-effect-error-tag": "error",
        "anti-slop-effect/no-manual-tag-comparison": "error",
        "anti-slop-effect/no-manual-tagged-construction": "error",
        "anti-slop-effect/prefer-effect-match": "error"
      }
    },
    {
      "files": ["packages/game-facts/src/packets.ts"],
      "rules": {
        "anti-slop/no-unknown-parameters": [
          "error",
          {
            "boundaryFunctions": ["decodeGamePacket"]
          }
        ]
      }
    },
    {
      "files": ["packages/protocol/src/rabbit/events.ts"],
      "rules": {
        "anti-slop/no-unknown-parameters": [
          "error",
          {
            "boundaryFunctions": ["decodeRabbitEvent"]
          }
        ]
      }
    },
    {
      "files": ["packages/database/src/redis-cache-fill.ts"],
      "rules": {
        "anti-slop/no-unknown-parameters": [
          "error",
          {
            "boundaryFunctions": ["stringify"]
          }
        ]
      }
    },
    {
      "files": ["packages/protocol/src/http/errors.ts"],
      "rules": {
        "anti-slop/no-unknown-parameters": [
          "error",
          {
            "boundaryFunctions": [
              "applicationErrorStatusOrUndefined",
              "applicationErrorHttpResponse"
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/protocol/src/realtime/codec.ts"],
      "rules": {
        "anti-slop/no-unknown-parameters": [
          "error",
          {
            "boundaryFunctions": ["decodeCommandSuccess"]
          }
        ]
      }
    },
    {
      "files": ["packages/domain/src/activity-feed.ts"],
      "rules": {
        "anti-slop/no-unknown-parameters": [
          "error",
          {
            "boundaryFunctions": ["parseActivityFeedSettings"]
          }
        ]
      }
    },
    {
      "files": ["packages/protocol/src/rabbit/activity-signature.ts"],
      "rules": {
        "anti-slop/no-unknown-parameters": [
          "error",
          {
            "boundaryFunctions": ["signActivityEvent"]
          }
        ]
      }
    },
    {
      "files": ["packages/protocol/src/openapi/sanitize.ts"],
      "rules": {
        "anti-slop/no-unsafe-dictionary-type": [
          "error",
          {
            "boundaryTypes": ["OpenApiDictionary"]
          }
        ],
        "anti-slop/no-unknown-parameters": [
          "error",
          {
            "boundaryFunctions": [
              "preserveLegacyQueryParameterSchemas",
              "preserveLegacyArraySchemaKeyOrder",
              "visitOpenApiDictionaries",
              "stripTypedObjectAdditionalProperties",
              "stripUnsupportedOpenApiKeywords",
              "ensurePathParameters"
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/schema/src/openapi-compatibility.ts"],
      "rules": {
        "anti-slop/no-unsafe-dictionary-type": [
          "error",
          {
            "boundaryTypes": ["JsonObject"]
          }
        ],
        "anti-slop/no-unknown-parameters": [
          "error",
          {
            "boundaryFunctions": [
              "normalizeSchema",
              "setOpenApiCompatibilityValue",
              "preserveOpenApi30Contract"
            ]
          }
        ],
        "anti-slop/no-runtime-typeof": [
          "error",
          {
            "allowInTypeGuards": true,
            "boundaryFunctions": [
              "normalizeSchemaAnnotations",
              "normalizeOperation"
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/schema/src/stable-json.ts"],
      "rules": {
        "anti-slop/no-unknown-parameters": [
          "error",
          {
            "boundaryFunctions": ["stableJsonStringify", "stableJsonCacheKey"]
          }
        ]
      }
    },
    {
      "files": [
        "apps/web/src/features/guild/events/components/scoring/scoring-rules-editor.tsx"
      ],
      "rules": {
        "anti-slop-effect/no-service-constructor-imports": [
          "error",
          {
            "nonServiceImports": ["makeRuleId"]
          }
        ]
      }
    },
    {
      "files": ["packages/instrumentation/src/observability.ts"],
      "rules": {
        "anti-slop-effect/no-service-constructor-imports": [
          "error",
          {
            "nonServiceImports": ["makeJsonLogger", "makeLocalLogger"]
          }
        ]
      }
    },
    {
      "files": ["apps/gateway/**/*.{ts,tsx}", "apps/activity/**/*.{ts,tsx}"],
      "rules": {
        "@typescript-eslint/consistent-type-imports": "off",
        "@typescript-eslint/no-explicit-any": "off",
        "@typescript-eslint/no-non-null-assertion": "off",
        "require-await": "off",
        "vitest/require-mock-type-parameters": "off"
      }
    },
    {
      "files": ["apps/discord-bot/**/*.{ts,tsx}"],
      "rules": {
        "@typescript-eslint/consistent-type-imports": "off",
        "@typescript-eslint/no-explicit-any": "off",
        "@typescript-eslint/no-non-null-assertion": "off",
        "require-await": "off",
        "vitest/require-mock-type-parameters": "off"
      }
    },
    {
      "files": ["packages/messaging/src/messaging.ts"],
      "rules": {
        "anti-slop/no-unsafe-dictionary-type": [
          "error",
          {
            "boundaryTypes": ["AmqpHeaders"]
          }
        ]
      }
    },
    {
      "files": ["packages/domain/src/npc-appearance.ts"],
      "rules": {
        "anti-slop/no-unknown-parameters": [
          "error",
          {
            "boundaryFunctions": [
              "normalizeAppearanceColor",
              "normalizeNpcTypeColors"
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/domain/src/chat-appearance.ts"],
      "rules": {
        "anti-slop/no-unknown-parameters": [
          "error",
          {
            "boundaryFunctions": [
              "normalizeNumber",
              "normalizeBoolean",
              "normalizeChatAppearanceSettings",
              "mergeChatAppearanceSettings",
              "getChatAppearancePreset"
            ]
          }
        ],
        "anti-slop/no-runtime-typeof": [
          "error",
          {
            "allowInTypeGuards": true,
            "boundaryFunctions": ["normalizeNumber", "normalizeBoolean"]
          }
        ]
      }
    },
    {
      "files": ["packages/domain/src/scoring.ts"],
      "rules": {
        "anti-slop/no-unknown-parameters": [
          "error",
          {
            "boundaryFunctions": [
              "toNumber",
              "toClock",
              "parseAction",
              "parseCondition",
              "parseGroupSizeCondition",
              "toPercentage",
              "parseRule",
              "normalizeEventScoringMode",
              "normalizeEventScoringRules"
            ]
          }
        ],
        "anti-slop/no-runtime-typeof": [
          "error",
          {
            "allowInTypeGuards": true,
            "boundaryFunctions": [
              "toNumber",
              "toClock",
              "parseCondition",
              "parseRule",
              "normalizeEventScoringRules"
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/domain/src/settings-documents.ts"],
      "rules": {
        "anti-slop/no-unsafe-dictionary-type": [
          "error",
          {
            "boundaryTypes": ["RawSettingsValues"]
          }
        ],
        "anti-slop/no-unknown-parameters": [
          "error",
          {
            "boundaryFunctions": ["isValid"]
          }
        ]
      }
    },
    {
      // Console output is the CLI, benchmark and maintenance script interface.
      "files": ["packages/cli/**", "**/*.bench.ts", "apps/*/src/scripts/**"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      // Async fakes preserve Promise contracts; fixtures use asserted indices.
      "files": ["**/*.test.{ts,tsx}"],
      "rules": {
        "require-await": "off",
        "@typescript-eslint/no-non-null-assertion": "off"
      }
    }
  ],
  "rules": {
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-runtime-typeof": [
      "error",
      {
        "allowInTypeGuards": true
      }
    ],
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error",
    "anti-slop-effect/no-service-constructor-imports": "error",
    "anti-slop/no-array-filter-map": "error",
    "anti-slop/no-reduce-accumulator-copy": "error",
    "anti-slop/require-readable-spacing": "error",
    "lootlog-comments/no-comments": [
      "error",
      {
        "baseline": "tools/oxlint/comments/baseline.json"
      }
    ],
    "lootlog/no-polling-loop-in-tests": [
      "error",
      {
        "baseline": "tools/oxlint/lootlog/baselines/no-polling-loop-in-tests.json"
      }
    ],
    "lootlog/no-real-time-wait-in-tests": [
      "error",
      {
        "baseline": "tools/oxlint/lootlog/baselines/no-real-time-wait-in-tests.json"
      }
    ],
    "lootlog/no-test-timeout-or-unreasoned-skip": [
      "error",
      {
        "baseline": "tools/oxlint/lootlog/baselines/no-test-timeout-or-unreasoned-skip.json"
      }
    ],
    "lootlog/no-wall-clock-in-tests": [
      "error",
      {
        "baseline": "tools/oxlint/lootlog/baselines/no-wall-clock-in-tests.json"
      }
    ],
    "lootlog/require-suppression-reason": "error",
    "oxc/no-accumulating-spread": "error",
    "complexity": "error",
    "eqeqeq": "error",
    "no-console": [
      "warn",
      {
        "allow": ["warn", "error"]
      }
    ],
    "no-debugger": "error",
    "no-alert": "error",
    "no-var": "error",
    "prefer-const": "error",
    "no-duplicate-imports": "error",
    "no-empty": [
      "warn",
      {
        "allowEmptyCatch": true
      }
    ],
    "no-empty-function": "off",
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-throw-literal": "error",
    "no-unused-expressions": "warn",
    "no-useless-concat": "warn",
    "no-useless-return": "warn",
    "require-await": "warn",
    // Polling, pagination, migrations and rate-limited work are sequential.
    "no-await-in-loop": "off",
    "@typescript-eslint/no-explicit-any": "warn",
    "@typescript-eslint/no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "@typescript-eslint/no-non-null-assertion": "warn",
    "@typescript-eslint/prefer-nullish-coalescing": "warn",
    "@typescript-eslint/prefer-optional-chain": "warn",
    "@typescript-eslint/no-unnecessary-condition": "off",
    "@typescript-eslint/no-floating-promises": "error",
    "@typescript-eslint/await-thenable": "error",
    "@typescript-eslint/no-misused-promises": "error",
    "@typescript-eslint/ban-ts-comment": "warn",
    "@typescript-eslint/consistent-type-imports": "warn",
    "@typescript-eslint/no-import-type-side-effects": "warn",
    "unicorn/catch-error-name": [
      "warn",
      {
        "ignore": ["cause"]
      }
    ],
    "unicorn/error-message": "error",
    "unicorn/no-array-for-each": "off",
    "unicorn/no-null": "off",
    "unicorn/prefer-module": "off",
    "unicorn/prefer-node-protocol": "warn",
    "unicorn/prefer-number-properties": "warn",
    "unicorn/prefer-string-slice": "warn",
    "unicorn/prefer-ternary": "off",
    "unicorn/throw-new-error": "error",
    "vitest/no-disabled-tests": "warn",
    "vitest/no-focused-tests": "error",
    "vitest/valid-expect": "error",
    // Typed implementations infer signatures; assertion-only spies need no signature.
    "vitest/require-mock-type-parameters": "off",
    // Effect generators capture their owning service with self.
    "@typescript-eslint/no-this-alias": [
      "warn",
      {
        "allowedNames": ["self"]
      }
    ]
  }
}
