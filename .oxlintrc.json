{
  "plugins": ["react", "typescript", "unicorn", "vitest"],
  "ignorePatterns": [
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    ".codegraph/**",
    "tools/oxlint/anti-slop/**",
    "**/node_modules",
    "**/dist",
    "**/build",
    "**/coverage",
    "**/.source",
    "**/*.tsbuildinfo",
    ".agents/skills/**/scripts/**",
    "packages/client/src/generated/**"
  ],
  "jsPlugins": [
    {
      "name": "anti-slop",
      "specifier": "./tools/oxlint/anti-slop/index.ts"
    },
    {
      "name": "anti-slop-effect",
      "specifier": "./tools/oxlint/anti-slop/effect/index.ts"
    }
  ],
  "env": {
    "browser": true,
    "node": true,
    "es2021": true
  },
  "settings": {
    "react": {
      "version": "19.0"
    }
  },
  "overrides": [
    {
      "files": ["packages/protocol/src/rabbit/events.ts"],
      "rules": {
        "anti-slop/no-unknown-parameters": [
          "error",
          {
            "boundaryFunctions": ["decodeRabbitEvent"]
          }
        ]
      }
    },
    {
      "files": ["packages/protocol/src/rabbit/activity-signature.ts"],
      "rules": {
        "anti-slop/no-unknown-parameters": [
          "error",
          {
            "boundaryFunctions": ["signActivityEvent"]
          }
        ]
      }
    },
    {
      "files": ["packages/protocol/src/openapi/sanitize.ts"],
      "rules": {
        "anti-slop/no-unsafe-dictionary-type": [
          "error",
          {
            "boundaryTypes": ["OpenApiDictionary"]
          }
        ],
        "anti-slop/no-unknown-parameters": [
          "error",
          {
            "boundaryFunctions": [
              "preserveLegacyQueryParameterSchemas",
              "preserveLegacyArraySchemaKeyOrder",
              "visitOpenApiDictionaries",
              "stripTypedObjectAdditionalProperties",
              "stripUnsupportedOpenApiKeywords",
              "ensurePathParameters"
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/schema/src/openapi-compatibility.ts"],
      "rules": {
        "anti-slop/no-unsafe-dictionary-type": [
          "error",
          {
            "boundaryTypes": ["JsonObject"]
          }
        ],
        "anti-slop/no-unknown-parameters": [
          "error",
          {
            "boundaryFunctions": [
              "normalizeSchema",
              "setOpenApiCompatibilityValue",
              "preserveOpenApi30Contract"
            ]
          }
        ],
        "anti-slop/no-runtime-typeof": [
          "error",
          {
            "allowInTypeGuards": true,
            "boundaryFunctions": [
              "normalizeSchemaAnnotations",
              "normalizeOperation"
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/schema/src/stable-json.ts"],
      "rules": {
        "anti-slop/no-unknown-parameters": [
          "error",
          {
            "boundaryFunctions": ["stableJsonStringify"]
          }
        ]
      }
    },
    {
      "files": ["apps/activity/src/http/activity-http.ts"],
      "rules": {
        "react-hooks/rules-of-hooks": "off"
