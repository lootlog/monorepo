{
  "extends": ["../../.oxlintrc.react.json"],
  "overrides": [
    {
      "files": ["src/lib/items-search.ts"],
      "rules": {
        "anti-slop/no-runtime-typeof": [
          "error",
          {
            "allowInTypeGuards": true,
            "boundaryFunctions": ["validateItemsSearch"]
          }
        ]
      }
    },
    {
      "files": ["src/routes/-search-route.utils.ts"],
