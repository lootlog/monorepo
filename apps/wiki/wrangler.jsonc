{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lootlog-wiki",
  "compatibility_date": "2026-04-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "wiki.lootlog.pl",
      "custom_domain": true,
    },
  ],
  "env": {
    "develop": {
      "name": "lootlog-wiki-develop",
      "routes": [
        {
          "pattern": "dev-wiki.lootlog.pl",
          "custom_domain": true,
        },
      ],
    },
  },
}
