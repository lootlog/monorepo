{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lootlog-wiki",
  "compatibility_date": "2026-04-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "wiki.lootlog.pl",
      "custom_domain": true,
    },
  ],
  "vars": {
    "VITE_API_URL": "https://api.lootlog.pl",
    "VITE_AUTH_SERVICE_URL": "https://auth.lootlog.pl",
    "VITE_SEARCH_API_URL": "https://search.lootlog.pl",
    "VITE_WEB_APP_URL": "https://lootlog.pl",
  },
  "env": {
    "develop": {
      "name": "lootlog-wiki-develop",
      "routes": [
        {
          "pattern": "dev-wiki.lootlog.pl",
          "custom_domain": true,
        },
      ],
      "vars": {
        "VITE_API_URL": "https://dev-api.lootlog.pl",
        "VITE_AUTH_SERVICE_URL": "https://dev-auth.lootlog.pl",
        "VITE_SEARCH_API_URL": "https://dev-search.lootlog.pl",
        "VITE_WEB_APP_URL": "https://dev.lootlog.pl",
      },
    },
  },
}
