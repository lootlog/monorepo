{
  "name": "@lootlog/wiki",
  "version": "0.1.10",
  "private": true,
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && tsc --noEmit",
    "preview": "vite preview",
    "deploy": "wrangler deploy dist/server/index.js --config wrangler.jsonc --env=\"\" --assets dist/client",
    "deploy:develop": "wrangler deploy dist/server/index.js --config wrangler.jsonc --env develop --assets dist/client",
    "deploy:version": "wrangler versions upload dist/server/index.js --config wrangler.jsonc --env=\"\" --assets dist/client",
    "deploy:version:develop": "wrangler versions upload dist/server/index.js --config wrangler.jsonc --env develop --assets dist/client",
    "cloudflare:typegen": "wrangler types",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ./vitest.config.ts"
  },
  "dependencies": {
    "@lootlog/client": "workspace:*",
    "@lootlog/ui": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-query-devtools": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-start": "^1.168.49",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.1",
    "@lootlog/typescript-config": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "^4.127.0"
  }
}
