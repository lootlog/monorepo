{
  "name": "@lootlog/game-client",
  "version": "1.2.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local-prod": "pnpm run build:local-prod && node ./src/scripts/serve-local-build.mjs",
    "build": "tsc && vite build && node ./src/scripts/copy-entrypoint.mjs",
    "build:fast": "tsc && FAST_BUILD=1 vite build && node ./src/scripts/copy-entrypoint.mjs",
    "build:local-prod": "tsc && vite build --mode production-local && node ./src/scripts/generate-local-entrypoint.mjs --output ./dist/@lootlog/game-client-local.user.js --bundle-url http://127.0.0.1:4173/@lootlog/game-client.user.js",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src --deny-warnings",
    "doctor": "npx -y react-doctor@latest .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:changed": "node ./scripts/report-changed-coverage.mjs",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "bench:runtime": "vitest bench src/lib/margonem-runtime/runtime-replay.bench.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@hookform/resolvers": "catalog:",
    "@lexical/react": "0.48.0",
    "@lexical/utils": "0.48.0",
    "@lootlog/api-client": "workspace:*",
    "@lootlog/margonem": "workspace:*",
    "@lootlog/socket-parser": "workspace:*",
    "@lootlog/types": "workspace:*",
    "@sentry/react": "^10.68.0",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-query": "catalog:",
    "better-auth": "^1.6.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "i18next": "^26.3.6",
    "lexical": "0.48.0",
    "lucide-react": "^1.26.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-error-boundary": "^6.1.2",
    "react-hook-form": "catalog:",
    "react-i18next": "^17.0.11",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "catalog:",
    "tw-animate-css": "^1.4.0",
    "zod": "catalog:",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "^0.2.3",
    "@sentry/vite-plugin": "^5.4.0",
    "@tailwindcss/postcss": "catalog:",
    "@tanstack/react-query-devtools": "catalog:",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/ui": "^4.1.10",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.11.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "terser": "^5.49.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-monkey": "^8.1.0",
    "vitest": "catalog:"
  }
}
