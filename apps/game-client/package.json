{
  "name": "@lootlog/game-client",
  "version": "1.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "bench:hot-paths": "node --expose-gc ./node_modules/vitest/vitest.mjs run --config ./benchmarks/hot-paths/vitest.config.ts --reporter=verbose",
    "bench:soak": "node --expose-gc ./node_modules/vitest/vitest.mjs run --config ./benchmarks/soak/vitest.config.ts --reporter=verbose",
    "dev": "vite",
    "build": "tsc && vite build && node ./src/scripts/copy-entrypoint.mjs",
    "build:fast": "tsc && FAST_BUILD=1 vite build && node ./src/scripts/copy-entrypoint.mjs",
    "build:local-prod": "tsc && vite build --mode production-local && node ./src/scripts/generate-local-entrypoint.mjs --output ./dist/@lootlog/game-client-local.user.js --bundle-url http://127.0.0.1:4173/@lootlog/game-client.user.js",
    "check-types": "tsc --noEmit",
    "check:changed-coverage": "node ./scripts/check-changed-coverage.mjs",
    "doctor": "npx -y react-doctor@latest .",
    "lint": "oxlint src benchmarks perf-fixture --deny-warnings",
    "local:prod": "pnpm run build:local-prod && node ./src/scripts/serve-local-build.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:browser-perf": "node ./perf-fixture/run-browser-perf.mjs",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@lootlog/margonem": "workspace:*",
    "@lootlog/socket-parser": "workspace:*",
    "@lootlog/types": "workspace:*",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/react": "^10.67.0",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/react-query": "^5.99.2",
    "better-auth": "^1.6.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "i18next": "^26.0.6",
    "lucide-react": "^1.8.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-error-boundary": "^6.1.1",
    "react-hook-form": "7.67.0",
    "react-i18next": "^17.0.4",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "^0.2.3",
    "@sentry/vite-plugin": "^5.4.0",
    "@tailwindcss/postcss": "^4.3.1",
    "@tanstack/react-query-devtools": "^5.99.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/ui": "^4.1.8",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.10.3",
    "playwright-core": "^1.61.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "terser": "^5.46.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-monkey": "^8.0.6",
    "vitest": "^4.1.8"
  }
}
