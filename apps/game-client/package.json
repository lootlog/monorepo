{
  "name": "@lootlog/game-client",
  "version": "1.3.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local-prod": "bun run build:local-prod && bun ./src/scripts/serve-local-build.mjs",
    "build": "tsc && vite build && bun ./src/scripts/copy-entrypoint.mjs",
    "build:fast": "tsc && FAST_BUILD=1 vite build && bun ./src/scripts/copy-entrypoint.mjs",
    "build:local-prod": "tsc && vite build --mode production-local && bun ./src/scripts/generate-local-entrypoint.mjs --output ./dist/@lootlog/game-client-local.user.js --bundle-url http://127.0.0.1:4173/@lootlog/game-client.user.js",
    "preview": "vite preview",
    "typecheck": "wxt prepare && tsc --noEmit",
    "lint": "oxlint src extension wxt.config.ts vite.shared.ts --deny-warnings",
    "doctor": "react-doctor .",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "bench:runtime": "vitest bench src/lib/margonem-runtime/runtime-replay.bench.ts",
    "dev:extension": "wxt -b chrome --mv3",
    "dev:extension:firefox": "wxt -b firefox --mv3",
    "build:extension": "bun extension/build.ts build local chrome",
    "build:extension:firefox": "bun extension/build.ts build local firefox",
    "zip:extension": "bun extension/build.ts zip local chrome",
    "zip:extension:firefox": "bun extension/build.ts zip local firefox",
    "zip:extension:sources": "bun ./extension/package-sources.ts",
    "build:extension:production": "bun extension/build.ts build production chrome",
    "zip:extension:production": "bun extension/build.ts zip production chrome",
    "build:extension:production:firefox": "bun extension/build.ts build production firefox",
    "zip:extension:production:firefox": "bun extension/build.ts zip production firefox"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "catalog:",
    "@lexical/react": "catalog:",
    "@lexical/utils": "catalog:",
    "@lootlog/client": "workspace:*",
    "@lootlog/datetime": "workspace:*",
    "@lootlog/domain": "workspace:*",
    "@lootlog/margonem": "workspace:*",
    "@lootlog/protocol": "workspace:*",
    "@lootlog/schema": "workspace:*",
    "@lootlog/ui": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "better-auth": "1.7.2",
    "class-variance-authority": "^0.7.1",
    "cmdk": "1.1.1",
    "cn": "catalog:",
    "i18next": "^26.4.0",
    "lexical": "catalog:",
    "lucide-react": "^1.35.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-error-boundary": "^6.1.3",
    "react-hook-form": "catalog:",
    "react-i18next": "^17.0.12",
    "sonner": "^2.0.8",
    "zod": "catalog:",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@aklinker1/zero-zip": "1.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/postcss": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/ui": "^4.1.11",
    "babel-plugin-react-compiler": "^1.0.0",
    "happy-dom": "^20.11.12",
    "postcss-load-config": "catalog:",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "catalog:",
    "terser": "^5.51.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-monkey": "^8.1.0",
    "vitest": "catalog:",
    "wxt": "^0.21.0"
  }
}
