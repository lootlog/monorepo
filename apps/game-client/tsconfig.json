{
  "extends": "@lootlog/typescript-config/vite.json",
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "declaration": false,
    "declarationMap": false,
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["vitest/globals", "node"]
  },
  "include": [
    "src",
    "extension",
    "sandbox",
    "wxt.config.ts",
    "vite.shared.ts",
    "vite.sandbox.config.ts",
    ".wxt/wxt.d.ts"
  ]
}
