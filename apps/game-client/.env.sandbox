# Standalone sandbox (`bun run dev:sandbox`). Requests go to the sandbox origin
# and vite.sandbox.config.ts proxies them to the local stack on http://localhost.
VITE_API_URL=http://localhost:3010/api/lootlog
VITE_GATEWAY_URL=http://localhost:3010
VITE_AUTH_SERVICE_URL=http://localhost:3010/api/auth
VITE_BATTLELOG_API_URL=http://localhost:3010/api/battlelog
VITE_LOOTLOG_APP_URL=http://localhost
VITE_GATEWAY_SOCKET_PATH=/gateway/ws
VITE_GATEWAY_FRAME_ENCODING=json
# Faction war art comes from apps/web/public, served by vite.sandbox.config.ts.
VITE_FACTION_WAR_ASSETS_URL=http://localhost:3010/faction-wars
