{
  "name": "@lootlog/battlelog",
  "version": "0.0.13",
  "private": true,
  "description": "",
  "license": "MIT",
  "author": "",
  "type": "module",
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "scripts": {
    "dev": "bun --env-file=.env --watch src/main.ts",
    "build": "bun build src/main.ts --target=bun --packages=external --outdir=dist/src --sourcemap=linked",
    "start": "bun dist/src/main.js",
    "start:debug": "bun --env-file=.env --inspect --watch src/main.ts",
    "lint": "oxlint src test",
    "typecheck": "bun check -p tsconfig.json",
    "format": "oxfmt src test",
    "test": "bun test --path-ignore-patterns='**/*.integration.*' src test",
    "test:debug": "bun test --inspect-brk src test",
    "test:watch": "bun test --watch src test",
    "openapi:generate": "bun src/openapi/generate-openapi.ts",
    "db:generate": "bunx drizzle-kit generate",
    "db:pull": "bunx drizzle-kit pull --config drizzle.config.ts",
    "db:migrate:deploy": "bun src/database/migrate.ts",
    "db:studio": "bunx drizzle-kit studio",
    "maintenance:audit-actions": "bun --env-file=.env scripts/audit-r2-battle-actions.ts",
    "test:integration": "bun test src/database/battle-read-budget.integration.test.ts src/battles/deletion/battle-deletion.integration.test.ts src/battles/submission/battle-creation-redis.integration.test.ts src/battles/weapon-kills/weapon-kills.integration.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1150.0",
    "@effect/platform-bun": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@lootlog/battle-processor": "workspace:*",
    "@lootlog/database": "workspace:*",
    "@lootlog/instrumentation": "workspace:*",
    "@lootlog/protocol": "workspace:*",
    "@lootlog/schema": "workspace:*",
    "bullmq": "^6.3.14",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "es-toolkit": "catalog:",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@effect/sql-pglite": "4.1.2",
    "@electric-sql/pglite": "^0.5.9",
    "@lootlog/typescript-config": "workspace:*",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "catalog:",
    "testcontainers": "^12.2.1",
    "typescript": "catalog:",
    "yaml": "catalog:"
  }
}
