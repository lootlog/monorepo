{
  "name": "@lootlog/search",
  "version": "1.0.11",
  "private": true,
  "license": "MIT",
  "type": "module",
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "build": "bun build src/main.ts --target=bun --packages=external --outdir=dist/src --sourcemap=linked",
    "start": "bun --enable-source-maps dist/src/main.js",
    "lint": "oxlint src test",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "openapi:generate": "bun src/openapi/generate-openapi.ts",
    "seed": "bun src/scripts/seed.ts"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:",
    "@lootlog/instrumentation": "workspace:*",
    "@lootlog/messaging": "workspace:*",
    "@lootlog/protocol": "workspace:*",
    "@lootlog/schema": "workspace:*",
    "effect": "catalog:",
    "meilisearch": "^0.60.0",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@lootlog/typescript-config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
