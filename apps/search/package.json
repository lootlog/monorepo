{
  "name": "@lootlog/search",
  "version": "1.0.11",
  "private": true,
  "license": "MIT",
  "type": "module",
  "imports": {
    "#src/*": {
      "types": "./src/*.ts",
      "default": "./dist/src/*.js"
    }
  },
  "scripts": {
    "dev": "nest start --watch",
    "prebuild": "node ../../tools/clean-swagger-metadata.mjs",
    "build": "nest build",
    "start": "node --import ./dist/src/instrumentation.js dist/src/main.js",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "test": "vitest run --config ./vitest.config.ts",
    "test:coverage": "vitest run --config ./vitest.config.ts --coverage",
    "test:debug": "vitest --config ./vitest.config.ts --inspect-brk --no-file-parallelism",
    "test:watch": "vitest --config ./vitest.config.ts",
    "openapi:generate": "OPENAPI_GENERATION=true pnpm build && OPENAPI_GENERATION=true node --import ./dist/src/instrumentation.js dist/src/openapi/generate-openapi.js",
    "seed": "tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "@golevelup/nestjs-rabbitmq": "^9.0.2",
    "@lootlog/instrumentation": "workspace:*",
    "@lootlog/nest-shared": "workspace:*",
    "@lootlog/types": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-fastify": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "dotenv": "^17.4.2",
    "fastify": "5.12.1",
    "meilisearch": "^0.60.0",
    "nest-winston": "catalog:",
    "nestjs-zod": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "winston": "^3.19.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@lootlog/typescript-config": "workspace:*",
    "@nestjs/cli": "catalog:",
    "@nestjs/schematics": "catalog:",
    "@nestjs/testing": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
