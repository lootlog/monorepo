# Service Configuration
PORT=4027
ENV=local
SERVICE_NAME=activity-service
APP_VERSION=0.0.1

# PostgreSQL Database
POSTGRESQL_CONNECTION_URI=postgresql://user:password@localhost:5435/activity_log

# OpenTelemetry (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_EXPORTER=otlp

# RabbitMQ Message Queue
RABBITMQ_URI=amqp://rabbitmq_user:rabbitmq_password@localhost:5672
ACTIVITY_EVENT_SIGNATURE_SECRET=replace-with-a-shared-gateway-activity-secret

# Redis Cache
REDIS_USERNAME=default
REDIS_PASSWORD=password
REDIS_HOST=localhost
REDIS_PORT=6379

# API Service
API_SERVICE_URL=http://localhost:4003
