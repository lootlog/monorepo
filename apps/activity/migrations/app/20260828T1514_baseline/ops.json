    "id": "foreignKey.Activity.Activity_actorSnapshotId_fkey",
    "label": "Add foreign key \"Activity_actorSnapshotId_fkey\" on \"Activity\"",
    "operationClass": "additive",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "foreignKey",
        "name": "Activity_actorSnapshotId_fkey",
        "table": "Activity"
      }
    },
    "precheck": [
      {
        "description": "ensure FK \"Activity_actorSnapshotId_fkey\" does not exist",
        "sql": "SELECT NOT EXISTS (SELECT 1 AS \"one\" FROM \"pg_constraint\" AS \"c\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"connamespace\" WHERE (\"c\".\"conname\" = $1 AND \"n\".\"nspname\" = $2 AND \"c\".\"conrelid\" = to_regclass($3))) AS \"result\"",
        "params": [
          "Activity_actorSnapshotId_fkey",
          "public",
          "\"public\".\"Activity\""
        ]
      }
    ],
    "execute": [
      {
        "description": "add FK \"Activity_actorSnapshotId_fkey\"",
        "sql": "ALTER TABLE \"public\".\"Activity\"\nADD CONSTRAINT \"Activity_actorSnapshotId_fkey\"\nFOREIGN KEY (\"actorSnapshotId\")\nREFERENCES \"public\".\"ActivityActorSnapshot\" (\"id\")\nON DELETE SET NULL\nON UPDATE CASCADE"
      }
    ],
    "postcheck": [
      {
        "description": "verify FK \"Activity_actorSnapshotId_fkey\" exists",
        "sql": "SELECT EXISTS (SELECT 1 AS \"one\" FROM \"pg_constraint\" AS \"c\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"connamespace\" WHERE (\"c\".\"conname\" = $1 AND \"n\".\"nspname\" = $2 AND \"c\".\"conrelid\" = to_regclass($3))) AS \"result\"",
