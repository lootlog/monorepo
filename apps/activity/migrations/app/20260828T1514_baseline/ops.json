  {
    "id": "timescaledb.Activity.hypertable",
    "label": "Convert Activity to a TimescaleDB hypertable",
    "operationClass": "additive",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "table",
        "name": "Activity"
      }
    },
    "precheck": [],
    "execute": [
      {
        "description": "convert Activity to a hypertable partitioned by createdAt",
        "sql": "SELECT create_hypertable(\n              '\"public\".\"Activity\"',\n              'createdAt',\n              chunk_time_interval => INTERVAL '1 day',\n              migrate_data => TRUE,\n              if_not_exists => TRUE\n            )"
      }
    ],
    "postcheck": [
      {
        "description": "verify Activity is a hypertable",
        "sql": "SELECT EXISTS (\n              SELECT 1\n              FROM timescaledb_information.hypertables\n              WHERE hypertable_schema = 'public'\n                AND hypertable_name = 'Activity'\n            ) AS result"
      }
    ]
  },
