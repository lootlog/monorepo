{
  "name": "@lootlog/activity",
  "version": "0.0.5",
  "private": true,
  "description": "",
  "license": "MIT",
  "author": "",
  "scripts": {
    "dev": "APP_VERSION=$(node -p \"require('./package.json').version\") nest start --watch",
    "prebuild": "pnpm activity:generate",
    "build": "nest build",
    "start": "APP_VERSION=$(node -p \"require('./package.json').version\") node dist/src/main.js",
    "start:debug": "nest start --debug --watch",
    "lint": "oxlint src",
    "format": "oxfmt src test",
    "test": "vitest run --config ./vitest.config.ts",
    "test:coverage": "vitest run --config ./vitest.config.ts --coverage",
    "test:debug": "vitest --config ./vitest.config.ts --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:watch": "vitest --config ./vitest.config.ts",
    "openapi:generate": "OPENAPI_GENERATION=true APP_VERSION=$(node -p \"require('./package.json').version\") pnpm build && OPENAPI_GENERATION=true APP_VERSION=$(node -p \"require('./package.json').version\") node dist/src/openapi/generate-openapi.js",
    "activity:generate": "prisma generate",
    "activity:migrate:dev": "prisma migrate dev",
    "activity:studio": "prisma studio"
  },
  "dependencies": {
    "@golevelup/nestjs-rabbitmq": "^9.0.2",
    "@keyv/redis": "^5.1.6",
    "@lootlog/nest-shared": "workspace:*",
    "@lootlog/types": "workspace:*",
    "@nestjs/axios": "catalog:",
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/platform-fastify": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@nestjs/terminus": "^11.1.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "axios": "^1.19.0",
    "cache-manager": "^7.2.9",
    "cacheable": "^2.5.0",
    "dotenv": "^17.4.2",
    "keyv": "^5.6.0",
    "nest-winston": "catalog:",
    "nestjs-zod": "catalog:",
    "pg": "^8.22.0",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "winston": "^3.19.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "catalog:",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "catalog:",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "catalog:",
    "prisma": "^7.9.0",
    "supertest": "^7.2.2",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:"
  }
}
