{
  "name": "@lootlog/activity",
  "version": "0.0.9",
  "private": true,
  "description": "",
  "license": "MIT",
  "author": "",
  "scripts": {
    "dev": "APP_VERSION=$(node -p \"require('./package.json').version\") nest start --watch",
    "build": "nest build",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "start": "APP_VERSION=$(node -p \"require('./package.json').version\") node dist/src/main.js",
    "start:debug": "nest start --debug --watch",
    "lint": "oxlint src test",
    "format": "oxfmt src test",
    "test": "vitest run --config ./vitest.config.ts",
    "test:coverage": "vitest run --config ./vitest.config.ts --coverage",
    "test:debug": "vitest --config ./vitest.config.ts --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:database": "vitest run --config ./vitest.config.database.ts",
    "test:watch": "vitest --config ./vitest.config.ts",
    "openapi:generate": "OPENAPI_GENERATION=true APP_VERSION=$(node -p \"require('./package.json').version\") pnpm build && OPENAPI_GENERATION=true APP_VERSION=$(node -p \"require('./package.json').version\") node dist/src/openapi/generate-openapi.js",
    "activity:contract:emit": "prisma contract emit",
    "activity:contract:infer": "prisma contract infer --output prisma/contract.prisma",
    "activity:migration:check": "prisma migration check",
    "activity:migration:plan": "prisma migration plan",
    "activity:migration:status": "prisma migration status --to db",
    "activity:db:migrate": "prisma db migrate --advance-ref db",
    "activity:db:sign": "prisma db sign --contract db",
    "activity:db:verify": "prisma db verify"
  },
  "dependencies": {
    "@golevelup/nestjs-rabbitmq": "^9.0.2",
    "@keyv/redis": "^5.1.6",
    "@lootlog/nest-shared": "workspace:*",
    "@lootlog/types": "workspace:*",
    "@nestjs/axios": "catalog:",
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/platform-fastify": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@nestjs/terminus": "^11.1.1",
    "@prisma/orm-family-sql": "8.0.0-rc.8",
    "@prisma/orm-postgres": "8.0.0-rc.8",
    "axios": "^1.20.0",
    "cache-manager": "^7.2.9",
    "cacheable": "^2.5.0",
    "dotenv": "^17.4.2",
    "keyv": "^5.6.0",
    "nest-winston": "catalog:",
    "nestjs-zod": "catalog:",
    "pg": "^8.23.0",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "temporal-polyfill": "1.0.4",
    "winston": "^3.19.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "catalog:",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "catalog:",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "catalog:",
    "@types/pg": "8.20.4",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "catalog:",
    "prisma": "8.0.0-rc.12",
    "supertest": "^7.2.2",
    "testcontainers": "^12.1.0",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:"
  }
}
