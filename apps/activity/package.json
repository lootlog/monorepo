{
  "name": "@lootlog/activity",
  "version": "0.0.12",
  "private": true,
  "description": "",
  "license": "MIT",
  "author": "",
  "type": "module",
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "build": "bun build src/main.ts --target=bun --packages=external --outdir=dist/src --sourcemap=linked",
    "start": "bun --enable-source-maps dist/src/main.js",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt src",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:e2e": "bun test src/http/activity-http.test.ts",
    "test:watch": "bun test --watch",
    "openapi:generate": "bun src/openapi/generate-openapi.ts",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate:dev": "bun src/database/migrate.ts",
    "db:migrate:deploy": "bun src/database/migrate.ts",
    "db:studio": "bunx drizzle-kit studio"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@lootlog/domain": "workspace:*",
    "@lootlog/messaging": "workspace:*",
    "@lootlog/protocol": "workspace:*",
    "@lootlog/schema": "workspace:*",
    "@paralleldrive/cuid2": "^3.3.0",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "ioredis": "5.11.1",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@lootlog/typescript-config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:"
  }
}
