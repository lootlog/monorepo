# Service Configuration
ENV=local
PORT=4010
SERVICE_NAME=notifications-worker

# PostgreSQL Database
POSTGRESQL_CONNECTION_URI=postgresql://user:password@localhost:5436/notifications

# RabbitMQ
RABBITMQ_URI=amqp://user:password@localhost:5672

# Redis (for BullMQ)
REDIS_USERNAME=default
REDIS_PASSWORD=redis_password
REDIS_HOST=localhost
REDIS_PORT=6379

# Discord Bot URL (for channel sync)
DISCORD_BOT_URL=http://localhost:4008

# Axiom Logging (optional, only for non-local environments)
AXIOM_DATASET=your_axiom_dataset
AXIOM_TOKEN=your_axiom_token

# OpenTelemetry Configuration
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_NODE_RESOURCE_DETECTORS=env,host,os,process
OTEL_TRACES_EXPORTER=otlp
SERVICE_NAMESPACE=local
