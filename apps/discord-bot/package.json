{
  "name": "@lootlog/discord-bot",
  "version": "1.0.10",
  "private": true,
  "description": "",
  "license": "MIT",
  "author": "",
  "type": "module",
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "build": "bun build src/main.ts --target=bun --packages=external --outdir=dist/src --sourcemap=linked",
    "start": "bun --enable-source-maps dist/src/main.js",
    "lint": "oxlint src test",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt src test",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:e2e": "bun test test",
    "test:watch": "bun test --watch"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:",
    "@lootlog/messaging": "workspace:*",
    "@lootlog/protocol": "workspace:*",
    "@lootlog/schema": "workspace:*",
    "discord-api-types": "0.37.120",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@lootlog/typescript-config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
