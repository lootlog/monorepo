  "scripts": {
    "build": "nest build",
    "format": "oxfmt src test",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start": "node --import ./dist/instrumentation.js dist/main.js",
    "lint": "oxlint src",
    "test": "vitest run --config ./vitest.config.ts",
    "test:watch": "vitest --config ./vitest.config.ts",
    "test:cov": "vitest run --config ./vitest.config.ts --coverage",
    "test:debug": "vitest --config ./vitest.config.ts --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@axiomhq/winston": "^1.6.0",
    "@golevelup/nestjs-rabbitmq": "^9.0.0",
    "@lootlog/instrumentation": "workspace:*",
    "@lootlog/nest-shared": "workspace:*",
    "@lootlog/types": "workspace:*",
    "@nestjs/common": "^11.1.18",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.18",
    "@nestjs/microservices": "^11.1.18",
    "@nestjs/platform-express": "^11.1.18",
    "discord.js": "^14.26.2",
    "dotenv": "^17.4.0",
    "joi": "^18.1.2",
    "necord": "^6.12.4",
    "nest-winston": "^1.10.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.17",
    "@nestjs/testing": "^11.1.18",
