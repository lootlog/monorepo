# Service Configuration
ENV=local
PORT=4008
SERVICE_NAME=discord-bot

# Discord Bot
DISCORD_BOT_TOKEN=xxx

# Services reached by slash commands
API_SERVICE_URL=http://localhost:4003
SEARCH_SERVICE_URL=http://localhost:4002
GATEWAY_SERVICE_URL=http://localhost:4004
WEB_APP_URL=http://localhost

# RabbitMQ Message Queue
RABBITMQ_URI=amqp://user:password@localhost:5672

# OpenTelemetry Configuration
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_EXPORTER=otlp
SERVICE_NAMESPACE=local
