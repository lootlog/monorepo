# Service Configuration
PORT=4004
ENV=local
SERVICE_NAME=gateway
SERVICE_NAMESPACE=local
ALLOWED_WEB_ORIGINS=http://localhost:3000
WEBSOCKET_PATH=/ws
WEBSOCKET_MAX_BACKPRESSURE_BYTES=1048576
WEBSOCKET_MAX_BACKPRESSURE_STRIKES=3

# API Service
API_URL=http://localhost/api/lootlog
AUTH_URL=http://localhost/api/auth
MARGONEM_SIGNING_KEY_URL=https://staticinfo.margonem.pl/.well-known/signing-key.pem
MARGONEM_ACCOUNT_PROOF_REQUIRED=false

# RabbitMQ Message Queue
RABBITMQ_URI=amqp://rabbitmq_user:rabbitmq_password@localhost:5672
ACTIVITY_EVENT_SIGNATURE_SECRET=replace-with-a-shared-gateway-activity-secret

# Redis Cache
REDIS_USERNAME=default
REDIS_PASSWORD=redis_password
REDIS_HOST=localhost
REDIS_PORT=6379

# OpenTelemetry Configuration
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
