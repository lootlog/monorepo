{
  "name": "@lootlog/gateway",
  "version": "1.1.0",
  "private": true,
  "description": "",
  "license": "MIT",
  "author": "",
  "type": "module",
  "imports": {
    "#src/*": {
      "development": "./src/*.ts",
      "types": "./src/*.ts",
      "default": "./dist/src/*.js"
    }
  },
  "scripts": {
    "dev": "bun --conditions=development --env-file=.env --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "bun dist/src/main.js",
    "start:debug": "bun --conditions=development --env-file=.env --inspect --watch src/main.ts",
    "lint": "oxlint src test",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "format": "oxfmt src test",
    "test": "bun --conditions=development test --path-ignore-patterns=dist --path-ignore-patterns='**/*.integration.*' src/auth src/realtime src/rabbit test",
    "test:integration": "bun --conditions=development test test/realtime-redis.integration.test.ts",
    "test:debug": "bun --conditions=development test --inspect-brk --path-ignore-patterns=dist src/auth src/realtime src/rabbit test",
    "test:e2e": "bun --conditions=development test --path-ignore-patterns=dist test",
    "test:watch": "bun --conditions=development test --watch --path-ignore-patterns=dist src/auth src/realtime src/rabbit test",
    "openapi:generate": "bun src/openapi/generate-openapi.ts"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:",
    "@lootlog/messaging": "workspace:*",
    "@lootlog/protocol": "workspace:*",
    "@lootlog/schema": "workspace:*",
    "@msgpack/msgpack": "^3.1.3",
    "effect": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@lootlog/typescript-config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "testcontainers": "^12.1.0",
    "typescript": "catalog:"
  }
}
