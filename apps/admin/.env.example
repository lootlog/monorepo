# The auth service on the private network and the credential it shares with
# the panel (the same value as the auth service's ADMIN_API_SECRET).
AUTH_INTERNAL_URL=http://localhost:4001
ADMIN_API_SECRET=

# The origin the browser sees; state-changing requests from any other origin
# are refused.
ADMIN_ORIGIN=http://localhost:3012

# The Web app, where the operator signs in to Lootlog. The panel is open only
# to a session of a User listed in the auth service's ADMIN_ACCOUNT_IDS, and
# the session cookie must reach this origin (same site as COOKIE_DOMAIN).
LOOTLOG_WEB_URL=http://localhost

# The Lootlog API as the edge serves it. Aura grants go there with the
# operator's session, so the operator must hold the admin platform role.
LOOTLOG_API_URL=http://localhost/api/lootlog

# Cloudflare Access application guarding the tunnel. Required in production:
# the panel verifies the Access token on every request and trusts nothing else.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# Emails allowed to operate the panel, comma separated.
ADMIN_OPERATOR_EMAILS=

# Development server only: the operator recorded in the audit log when no
# Access application is configured. Ignored by a production build.
ADMIN_DEV_OPERATOR=dev@localhost
