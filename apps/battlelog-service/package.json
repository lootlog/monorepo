{
  "name": "@lootlog/battlelog-service",
  "version": "0.0.1",
  "private": true,
  "description": "",
  "license": "MIT",
  "author": "",
  "scripts": {
    "build": "nest build",
    "format": "oxfmt src test",
    "start": "node --import ./dist/src/instrumentation.js dist/src/main.js",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node --import ./dist/src/instrumentation.js dist/src/main.js",
    "lint": "oxlint src",
    "test": "vitest run --config ./vitest.config.ts",
    "test:watch": "vitest --config ./vitest.config.ts",
    "test:cov": "vitest run --config ./vitest.config.ts --coverage",
    "test:debug": "vitest --config ./vitest.config.ts --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "battlelog:push": "drizzle-kit push",
    "battlelog:generate": "drizzle-kit generate",
    "battlelog:migrate": "drizzle-kit migrate",
    "battlelog:migrate:init": "tsx --env-file=.env scripts/migrate-init.ts",
    "battlelog:migrate:dev": "drizzle-kit push --force",
    "battlelog:pull": "drizzle-kit pull",
    "battlelog:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1033.0",
    "@lootlog/battle-processor": "workspace:*",
    "@lootlog/instrumentation": "workspace:*",
    "@lootlog/nest-shared": "workspace:*",
    "@lootlog/types": "workspace:*",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.19",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.19",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/platform-fastify": "^11.1.19",
    "@nestjs/swagger": "^11.3.2",
    "@paralleldrive/cuid2": "^2.3.1",
    "bullmq": "^5.75.2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-beta.20",
    "ioredis": "^5.10.1",
    "joi": "^18.1.2",
    "nest-winston": "^1.10.2",
    "nestjs-zod": "^5.3.0",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.21",
    "@nestjs/testing": "^11.1.19",
    "@swc/cli": "^0.7.10",
    "@swc/core": "^1.15.30",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.4",
    "drizzle-kit": "1.0.0-beta.20",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.4"
  }
}
