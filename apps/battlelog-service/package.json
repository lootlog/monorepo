{
  "name": "@lootlog/battlelog-service",
  "version": "0.0.13",
  "private": true,
  "description": "",
  "license": "MIT",
  "author": "",
  "type": "module",
  "imports": {
    "#src/*": {
      "types": "./src/*.ts",
      "default": "./dist/src/*.js"
    }
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "bun --preload ./dist/src/instrumentation.js dist/src/main.js",
    "start:debug": "nest start --debug --watch",
    "lint": "oxlint src test",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "format": "oxfmt src test",
    "test": "vitest run --config ./vitest.config.ts",
    "test:coverage": "vitest run --config ./vitest.config.ts --coverage",
    "test:debug": "vitest --config ./vitest.config.ts --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:watch": "vitest --config ./vitest.config.ts",
    "openapi:generate": "OPENAPI_GENERATION=true bun run build && OPENAPI_GENERATION=true bun --preload ./dist/src/instrumentation.js dist/src/openapi/generate-openapi.js",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate:deploy": "bunx drizzle-kit migrate",
    "db:migrate:init": "bun --env-file=.env scripts/migrate-init.ts",
    "db:pull": "bunx drizzle-kit pull",
    "db:push": "bunx drizzle-kit push --force",
    "db:studio": "bunx drizzle-kit studio",
    "maintenance:audit-actions": "bun --env-file=.env scripts/audit-r2-battle-actions.ts",
    "maintenance:backfill-warrior-stats": "bun --env-file=.env scripts/backfill-battle-warrior-stats.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1120.0",
    "@lootlog/battle-processor": "workspace:*",
    "@lootlog/instrumentation": "workspace:*",
    "@lootlog/nest-shared": "workspace:*",
    "@lootlog/types": "workspace:*",
    "@nestjs/bullmq": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/platform-fastify": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@paralleldrive/cuid2": "^3.3.0",
    "bullmq": "^5.81.4",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-beta.20",
    "ioredis": "^5.11.1",
    "nest-winston": "catalog:",
    "nestjs-zod": "catalog:",
    "pg": "^8.23.0",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "winston": "^3.19.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@lootlog/typescript-config": "workspace:*",
    "@nestjs/cli": "catalog:",
    "@nestjs/schematics": "catalog:",
    "@nestjs/testing": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "catalog:",
    "drizzle-kit": "1.0.0-beta.20",
    "supertest": "^7.2.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
