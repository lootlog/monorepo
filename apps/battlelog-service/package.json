{
  "name": "@lootlog/battlelog-service",
  "version": "0.0.1",
  "private": true,
  "description": "",
  "license": "MIT",
  "author": "",
  "type": "module",
  "exports": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "oxfmt src test",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "start:prod": "node dist/index.js",
    "lint": "oxlint src",
    "test": "vitest run --config ./vitest.config.ts",
    "test:watch": "vitest --config ./vitest.config.ts",
    "test:cov": "vitest run --config ./vitest.config.ts --coverage",
    "test:debug": "vitest --config ./vitest.config.ts --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "battlelog:push": "drizzle-kit push",
    "battlelog:generate": "drizzle-kit generate",
    "battlelog:migrate": "drizzle-kit migrate",
    "battlelog:migrate:init": "tsx --env-file=.env scripts/migrate-init.ts",
    "battlelog:migrate:dev": "drizzle-kit push --force",
    "battlelog:pull": "drizzle-kit pull",
    "battlelog:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1032.0",
    "@axiomhq/winston": "^1.6.0",
    "@hono/node-server": "^1.19.14",
    "@hono/otel": "^1.1.1",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.3.0",
    "@lootlog/battle-processor": "workspace:*",
    "@lootlog/instrumentation": "workspace:*",
    "@lootlog/types": "workspace:*",
    "@paralleldrive/cuid2": "^2.3.1",
    "bullmq": "^5.74.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-beta.20",
    "hono": "^4.12.14",
    "ioredis": "^5.10.1",
    "pg": "^8.20.0",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@lootlog/typescript-config": "workspace:*",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.1.4",
    "drizzle-kit": "1.0.0-beta.20",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  }
}
