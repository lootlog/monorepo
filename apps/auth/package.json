{
  "name": "@lootlog/auth",
  "version": "1.0.11",
  "private": true,
  "license": "MIT",
  "type": "module",
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "build": "bun build src/main.ts --target=bun --outdir=dist/src --sourcemap=linked",
    "start": "bun --enable-source-maps dist/src/main.js",
    "start:debug": "bun --inspect --watch src/main.ts",
    "lint": "oxlint src scripts",
    "typecheck": "tsc --noEmit",
    "test": "bun test --path-ignore-patterns='**/*.integration.*'",
    "test:integration": "bun test src/auth/realtime/realtime-ticket.integration.spec.ts src/database/migrations.integration.spec.ts",
    "test:watch": "bun test --watch",
    "openapi:generate": "bun src/openapi/generate-openapi.ts",
    "auth:generate": "auth generate --config src/auth/provider/better-auth-cli.ts --output src/database/drizzle.schema.ts --yes",
    "auth:migrate:plan": "bun scripts/migration-plan.ts",
    "auth:migrate:apply": "bun scripts/migration-apply.ts",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate:dev": "bun scripts/migrate.ts",
    "db:migrate:deploy": "bun scripts/migrate.ts",
    "db:migrate:init": "bun scripts/migrate-init.ts",
    "db:studio": "bunx drizzle-kit studio"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:",
    "@lootlog/instrumentation": "workspace:*",
    "@lootlog/schema": "workspace:*",
    "better-auth": "1.7.2",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "jose": "^6.1.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@lootlog/typescript-config": "workspace:*",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "auth": "1.7.2",
    "drizzle-kit": "catalog:",
    "testcontainers": "^12.1.0",
    "typescript": "catalog:",
    "yaml": "catalog:"
  }
}
