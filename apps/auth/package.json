{
  "name": "@lootlog/auth",
  "version": "1.0.11",
  "private": true,
  "license": "MIT",
  "type": "module",
  "imports": {
    "#src/*": {
      "types": "./src/*.ts",
      "default": "./dist/src/*.js"
    }
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node --import ./dist/src/instrumentation.js dist/src/main.js",
    "start:debug": "nest start --debug --watch",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "test": "vitest run --config ./vitest.config.ts",
    "test:coverage": "vitest run --config ./vitest.config.ts --coverage",
    "test:watch": "vitest --config ./vitest.config.ts",
    "openapi:generate": "OPENAPI_GENERATION=true pnpm build && OPENAPI_GENERATION=true node --import ./dist/src/instrumentation.js dist/src/openapi/generate-openapi.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate:dev": "node --import tsx scripts/migrate.ts",
    "db:migrate:deploy": "node --import tsx scripts/migrate.ts",
    "db:migrate:init": "node --import tsx scripts/migrate-init.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@better-auth/redis-storage": "1.6.30",
    "@lootlog/api-helpers": "workspace:*",
    "@lootlog/instrumentation": "workspace:*",
    "@lootlog/nest-shared": "workspace:*",
    "@lootlog/types": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-fastify": "catalog:",
    "@nestjs/swagger": "catalog:",
    "better-auth": "1.6.30",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "5.12.1",
    "ioredis": "5.11.1",
    "nest-winston": "catalog:",
    "pg": "^8.23.0",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "winston": "^3.19.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@lootlog/typescript-config": "workspace:*",
    "@nestjs/cli": "catalog:",
    "@nestjs/schematics": "catalog:",
    "@nestjs/testing": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "catalog:",
    "drizzle-kit": "^0.31.10",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
