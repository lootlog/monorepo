{
  "name": "@lootlog/auth",
  "version": "1.0.11",
  "private": true,
  "license": "MIT",
  "type": "module",
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "build": "bun build src/main.ts --target=bun --outdir=dist/src --sourcemap=linked",
    "start": "bun --enable-source-maps dist/src/main.js",
    "start:debug": "bun --inspect --watch src/main.ts",
    "lint": "oxlint src scripts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:watch": "bun test --watch",
    "openapi:generate": "bun src/openapi/generate-openapi.ts",
    "http-api:generate": "bun ../../tools/openapi/generate-http-api.ts --spec openapi.yaml --output src/http-api/auth-api.generated.ts --name AuthApi --count 5",
    "auth:generate": "auth generate --config src/auth/better-auth-cli.ts --output src/database/drizzle.schema.ts --yes",
    "auth:migrate:plan": "bun scripts/migration-plan.ts",
    "auth:migrate:apply": "bun scripts/migration-apply.ts",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate:dev": "bun scripts/migrate.ts",
    "db:migrate:deploy": "bun scripts/migrate.ts",
    "db:migrate:init": "bun scripts/migrate-init.ts",
    "db:studio": "bunx drizzle-kit studio"
  },
  "dependencies": {
    "@better-auth/redis-storage": "1.7.2",
    "@effect/platform-bun": "catalog:",
    "better-auth": "1.7.2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "ioredis": "5.11.1",
    "jose": "^6.1.3",
    "pg": "^8.23.0",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@lootlog/typescript-config": "workspace:*",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "auth": "1.7.2",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:"
  }
}
