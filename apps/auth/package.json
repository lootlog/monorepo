{
  "name": "@lootlog/auth",
  "version": "1.0.7",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node --import ./dist/src/instrumentation.js dist/src/main.js",
    "start:debug": "nest start --debug --watch",
    "lint": "oxlint src",
    "test": "vitest run --config ./vitest.config.ts",
    "test:coverage": "vitest run --config ./vitest.config.ts --coverage",
    "test:watch": "vitest --config ./vitest.config.ts",
    "openapi:generate": "OPENAPI_GENERATION=true pnpm build && OPENAPI_GENERATION=true node --import ./dist/src/instrumentation.js dist/src/openapi/generate-openapi.js",
    "auth:generate": "drizzle-kit generate",
    "auth:migrate:dev": "node --import tsx scripts/migrate.ts",
    "auth:migrate:init": "node --import tsx scripts/migrate-init.ts",
    "auth:migrate:prod": "node --import tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.25",
    "@better-auth/redis-storage": "1.6.25",
    "@lootlog/api-helpers": "workspace:*",
    "@lootlog/instrumentation": "workspace:*",
    "@lootlog/nest-shared": "workspace:*",
    "@lootlog/types": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-fastify": "catalog:",
    "@nestjs/swagger": "catalog:",
    "better-auth": "^1.6.25",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.10.0",
    "ioredis": "5.11.1",
    "nest-winston": "catalog:",
    "pg": "^8.22.0",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "winston": "^3.19.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@lootlog/typescript-config": "workspace:*",
    "@nestjs/cli": "catalog:",
    "@nestjs/testing": "catalog:",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "catalog:",
    "drizzle-kit": "^0.31.10",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:"
  }
}
