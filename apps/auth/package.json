{
  "name": "@lootlog/auth",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": "./dist/index.mjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.mjs",
    "build": "pkgroll",
    "auth:migrate:dev": "pnpm dlx @better-auth/cli migrate --config ./src/lib/auth.ts",
    "auth:migrate:prod": "pnpm dlx @better-auth/cli migrate --config ./src/lib/auth.ts --y"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "@hono/otel": "^1.1.0",
    "@lootlog/api-helpers": "workspace:*",
    "@lootlog/instrumentation": "workspace:*",
    "better-auth": "^1.4.18",
    "dotenv": "^17.2.3",
    "hono": "^4.11.7",
    "kysely": "^0.28.11",
    "pg": "^8.18.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@lootlog/types": "workspace:*",
    "@lootlog/typescript-config": "workspace:*",
    "@types/pg": "^8.16.0",
    "pkgroll": "^2.23.0",
    "tsx": "^4.21.0"
  }
}
