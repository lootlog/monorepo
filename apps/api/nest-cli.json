{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "builder": "swc",
    "typeCheck": true,
    "assets": [
      { "include": "db/generated/contract.json", "outDir": "dist/src" }
    ],
    "plugins": ["@nestjs/swagger"],
    "deleteOutDir": true
  }
}
