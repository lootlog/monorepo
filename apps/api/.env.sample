# Service Configuration
PORT=4003
ENV=local
SERVICE_NAME=api

# PostgreSQL Database
POSTGRESQL_CONNECTION_URI=postgresql://user:password@localhost:5433/lootlog

# Axiom Logging (optional, only for non-local environments)
AXIOM_TOKEN=axiom_token_here
AXIOM_DATASET=axiom_dataset_here

# Prisma Optimize
OPTIMIZE_API_KEY=prisma_optimize_api_key_here

# RabbitMQ Message Queue
RABBITMQ_URI=amqp://rabbitmq_user:rabbitmq_password@localhost:5672

# Redis Cache
REDIS_USERNAME=default
REDIS_PASSWORD=redis_password
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth Service
AUTH_SERVICE_URL=http://localhost/api/auth

# Reservations Cards Service
RESERVATIONS_CARDS_URL=https://example.com/api/reservations/cards
MAPS_API_URL=https://example.com/api/maps

# OpenTelemetry Configuration
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_NODE_RESOURCE_DETECTORS=env,host,os,process
OTEL_TRACES_EXPORTER=otlp
SERVICE_NAMESPACE=local
