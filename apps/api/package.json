{
  "name": "@lootlog/api",
  "version": "5.0.8",
  "private": true,
  "description": "",
  "license": "MIT",
  "author": "",
  "type": "module",
  "imports": {
    "#src/*": {
      "types": "./src/*.ts",
      "default": "./dist/src/*.js"
    }
  },
  "scripts": {
    "dev": "nest start --watch",
    "prebuild": "bun ./tools/clean-swagger-metadata.mjs",
    "build": "nest build",
    "start": "bun --enable-source-maps dist/src/main.js",
    "start:debug": "nest start --debug --watch",
    "lint": "oxlint src test",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "format": "oxfmt src test",
    "test": "node ./node_modules/vitest/vitest.mjs run --config ./vitest.config.ts",
    "test:coverage": "node ./node_modules/vitest/vitest.mjs run --config ./vitest.config.ts --coverage",
    "test:debug": "node ./node_modules/vitest/vitest.mjs --config ./vitest.config.ts --inspect-brk --no-file-parallelism",
    "test:e2e": "node ./node_modules/vitest/vitest.mjs run --config ./vitest.config.e2e.ts",
    "test:watch": "node ./node_modules/vitest/vitest.mjs --config ./vitest.config.ts",
    "openapi:generate": "bun src/openapi/generate-effect-openapi.ts",
    "http-api:generate": "$npm_execpath src/http-api/generate-http-api.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate:dev": "bun src/database/drizzle/migrate.ts",
    "db:migrate:deploy": "bun src/database/drizzle/migrate.ts",
    "db:studio": "drizzle-kit studio --config drizzle.config.ts"
  },
  "dependencies": {
    "@discordjs/rest": "^2.6.3",
    "@effect/platform-bun": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@fastify/static": "^10.1.3",
    "@golevelup/nestjs-rabbitmq": "^9.0.2",
    "@lootlog/datetime": "workspace:*",
    "@lootlog/domain": "workspace:*",
    "@lootlog/nest-shared": "workspace:*",
    "@lootlog/schema": "workspace:*",
    "@nestjs/axios": "catalog:",
    "@nestjs/bullmq": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-fastify": "catalog:",
    "@nestjs/schedule": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@nestjs/websockets": "catalog:",
    "axios": "^1.20.0",
    "bullmq": "^5.81.4",
    "discord-api-types": "0.38.54",
    "dotenv": "^17.4.2",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "fastify": "5.12.1",
    "ioredis": "^5.11.1",
    "nestjs-zod": "catalog:",
    "redlock": "5.0.0-beta.2",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "sharp": "^0.35.4",
    "superjson": "catalog:",
    "uuid": "^14.0.2",
    "winston": "^3.19.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@effect/openapi-generator": "catalog:",
    "@effect/platform-node": "catalog:",
    "@lootlog/typescript-config": "workspace:*",
    "@nestjs/cli": "catalog:",
    "@nestjs/schematics": "catalog:",
    "@nestjs/testing": "catalog:",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "catalog:",
    "drizzle-kit": "catalog:",
    "pg": "^8.23.0",
    "supertest": "^7.2.2",
    "testcontainers": "^12.1.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  }
}
