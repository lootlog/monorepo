{
  "name": "@lootlog/api",
  "version": "5.0.4",
  "private": true,
  "description": "",
  "license": "MIT",
  "author": "",
  "scripts": {
    "dev": "nest start --watch",
    "prebuild": "node ../../tools/clean-swagger-metadata.mjs",
    "build": "nest build",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "start": "node --import ./dist/src/instrumentation.js dist/src/main.js",
    "start:debug": "nest start --debug --watch",
    "lint": "oxlint src test",
    "format": "oxfmt src test",
    "test": "vitest run --config ./vitest.config.ts",
    "test:coverage": "vitest run --config ./vitest.config.ts --coverage",
    "test:debug": "vitest --config ./vitest.config.ts --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:database": "vitest run --config ./vitest.config.database.ts",
    "test:watch": "vitest --config ./vitest.config.ts",
    "openapi:generate": "OPENAPI_GENERATION=true nest build --config nest-cli.openapi.json && OPENAPI_GENERATION=true node --import ./dist/src/instrumentation.js dist/src/openapi/generate-openapi.js",
    "api:contract:emit": "prisma contract emit && node scripts/patch-prisma-contract.mjs",
    "api:contract:infer": "prisma contract infer --output prisma/contract.prisma",
    "api:migration:check": "prisma migration check",
    "api:migration:plan": "prisma migration plan",
    "api:migration:status": "prisma migration status --to db",
    "api:db:migrate": "prisma db migrate --advance-ref db",
    "api:db:sign": "prisma db sign --contract db",
    "api:db:verify": "prisma db verify"
  },
  "dependencies": {
    "@discordjs/rest": "^2.6.3",
    "@fastify/static": "^10.1.3",
    "@golevelup/nestjs-rabbitmq": "^9.0.2",
    "@lootlog/api-helpers": "workspace:*",
    "@lootlog/datetime": "workspace:*",
    "@lootlog/instrumentation": "workspace:*",
    "@lootlog/nest-shared": "workspace:*",
    "@lootlog/scoring": "workspace:*",
    "@lootlog/types": "workspace:*",
    "@nestjs/axios": "catalog:",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/microservices": "catalog:",
    "@nestjs/platform-fastify": "catalog:",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "catalog:",
    "@nestjs/websockets": "^11.2.3",
    "@prisma/orm-family-sql": "8.0.0-rc.8",
    "@prisma/orm-postgres": "8.0.0-rc.8",
    "axios": "^1.20.0",
    "bullmq": "^5.81.4",
    "discord-api-types": "0.38.54",
    "dotenv": "^17.4.2",
    "fastify": "5.11.3",
    "ioredis": "^5.11.1",
    "js-yaml": "^5.4.1",
    "nest-winston": "catalog:",
    "nestjs-zod": "catalog:",
    "node-html-parser": "^9.0.2",
    "pg": "^8.23.0",
    "random-words": "^2.0.1",
    "redlock": "5.0.0-beta.2",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "sharp": "^0.35.4",
    "temporal-polyfill": "1.0.4",
    "uuid": "^14.0.2",
    "winston": "^3.19.0",
    "zod": "catalog:",
    "zx": "^8.8.5"
  },
  "devDependencies": {
    "@nestjs/cli": "catalog:",
    "@nestjs/testing": "catalog:",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "catalog:",
    "@types/pg": "8.20.4",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "catalog:",
    "prisma": "8.0.0-rc.12",
    "supertest": "^7.2.2",
    "testcontainers": "^12.1.0",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:"
  }
}
