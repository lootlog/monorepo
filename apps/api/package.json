{
  "name": "@lootlog/api",
  "version": "3.0.0",
  "private": true,
  "description": "",
  "license": "MIT",
  "author": "",
  "scripts": {
    "prebuild": "node ../../tools/clean-swagger-metadata.mjs && pnpm api:generate",
    "build": "nest build",
    "format": "oxfmt src test",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start": "node --import ./dist/src/instrumentation.js dist/src/main.js",
    "lint": "oxlint src",
    "openapi:generate": "OPENAPI_GENERATION=true pnpm api:generate && OPENAPI_GENERATION=true nest build --config nest-cli.openapi.json && OPENAPI_GENERATION=true node --import ./dist/src/instrumentation.js dist/src/openapi/generate-openapi.js",
    "test": "vitest run --config ./vitest.config.ts",
    "test:watch": "vitest --config ./vitest.config.ts",
    "test:cov": "vitest run --config ./vitest.config.ts --coverage",
    "test:debug": "vitest --config ./vitest.config.ts --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "api:migrate:dev": "prisma migrate dev",
    "api:generate": "prisma generate",
    "api:studio": "prisma studio",
    "bench:hot-paths": "node ./benchmarks/hot-paths.mjs"
  },
  "dependencies": {
    "@discordjs/rest": "^2.6.3",
    "@fastify/static": "^10.1.2",
    "@golevelup/nestjs-rabbitmq": "^9.0.2",
    "@lootlog/api-helpers": "workspace:*",
    "@lootlog/instrumentation": "workspace:*",
    "@lootlog/nest-shared": "workspace:*",
    "@lootlog/types": "workspace:*",
    "@nestjs/axios": "catalog:",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/microservices": "catalog:",
    "@nestjs/platform-fastify": "catalog:",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "catalog:",
    "@nestjs/websockets": "^11.1.28",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "axios": "^1.18.1",
    "bullmq": "^5.81.2",
    "discord-api-types": "0.38.52",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "ioredis": "^5.11.1",
    "js-yaml": "^5.2.2",
    "nest-winston": "catalog:",
    "nestjs-zod": "catalog:",
    "pg": "^8.22.0",
    "redlock": "5.0.0-beta.2",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "sharp": "^0.35.3",
    "uuid": "^14.0.1",
    "winston": "^3.19.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "catalog:",
    "@nestjs/testing": "catalog:",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@testcontainers/postgresql": "^12.0.4",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "catalog:",
    "prisma": "7.9.0",
    "supertest": "^7.2.2",
    "testcontainers": "^12.0.4",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:"
  }
}
