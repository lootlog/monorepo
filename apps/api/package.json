{
  "name": "@lootlog/api",
  "version": "5.0.8",
  "private": true,
  "description": "",
  "license": "MIT",
  "author": "",
  "type": "module",
  "imports": {
    "#src/*": {
      "types": "./src/*.ts",
      "development": "./src/*.ts",
      "default": "./dist/src/*.js"
    }
  },
  "scripts": {
    "dev": "bun --conditions=development --watch --enable-source-maps src/main.ts",
    "prebuild": "bun ./tools/clean-build.mjs",
    "build": "tsc -p tsconfig.build.json",
    "start": "bun --enable-source-maps dist/src/main.js",
    "start:debug": "bun --conditions=development --inspect-wait --watch --enable-source-maps src/main.ts",
    "lint": "oxlint src test",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "format": "oxfmt src test",
    "test": "bun run test:legacy && bun run test:effect",
    "test:legacy": "node ./node_modules/vitest/vitest.mjs run --config ./vitest.config.ts",
    "test:effect": "bun --conditions=development test --path-ignore-patterns=dist src/http-api",
    "test:coverage": "node ./node_modules/vitest/vitest.mjs run --config ./vitest.config.ts --coverage",
    "test:debug": "node ./node_modules/vitest/vitest.mjs --config ./vitest.config.ts --inspect-brk --no-file-parallelism",
    "test:e2e": "node ./node_modules/vitest/vitest.mjs run --config ./vitest.config.e2e.ts",
    "test:watch": "node ./node_modules/vitest/vitest.mjs --config ./vitest.config.ts",
    "openapi:generate": "bun src/openapi/generate-effect-openapi.ts",
    "http-api:generate": "$npm_execpath src/http-api/generate-http-api.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate:dev": "bun src/database/drizzle/migrate.ts",
    "db:migrate:deploy": "bun src/database/drizzle/migrate.ts",
    "db:studio": "drizzle-kit studio --config drizzle.config.ts"
  },
  "dependencies": {
    "@discordjs/rest": "^2.6.3",
    "@effect/platform-bun": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@lootlog/datetime": "workspace:*",
    "@lootlog/domain": "workspace:*",
    "@lootlog/messaging": "workspace:*",
    "@lootlog/protocol": "workspace:*",
    "@lootlog/schema": "workspace:*",
    "bullmq": "^5.81.4",
    "discord-api-types": "0.38.54",
    "dotenv": "^17.4.2",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "ioredis": "^5.11.1",
    "redlock": "5.0.0-beta.2",
    "sharp": "^0.35.4",
    "superjson": "catalog:",
    "uuid": "^14.0.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@effect/openapi-generator": "catalog:",
    "@effect/platform-node": "catalog:",
    "@lootlog/typescript-config": "workspace:*",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "catalog:",
    "drizzle-kit": "catalog:",
    "pg": "^8.23.0",
    "supertest": "^7.2.2",
    "testcontainers": "^12.1.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  }
}
