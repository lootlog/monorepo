{
  "name": "@lootlog/api",
  "version": "5.0.8",
  "private": true,
  "description": "",
  "license": "MIT",
  "author": "",
  "type": "module",
  "imports": {
    "#src/*": {
      "types": "./src/*.ts",
      "development": "./src/*.ts",
      "default": "./dist/src/*.js"
    }
  },
  "exports": {
    "./database/schema": "./src/database/drizzle/schema.ts",
    "./timers/timer-key": "./src/timers/timer-key.ts"
  },
  "scripts": {
    "dev": "bun --conditions=development --watch --enable-source-maps src/main.ts",
    "prebuild": "bun ./tools/clean-build.mjs",
    "build": "tsc -p tsconfig.build.json",
    "start": "bun --enable-source-maps dist/src/main.js",
    "start:debug": "bun --conditions=development --inspect-wait --watch --enable-source-maps src/main.ts",
    "lint": "oxlint src test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "oxfmt src test",
    "test": "bun --conditions=development test --path-ignore-patterns=dist src",
    "test:integration": "bun --conditions=development test --preload ./test/bun.e2e.setup.ts --max-concurrency 1 ./test/*.integration.test.ts",
    "test:debug": "bun --conditions=development test --inspect-brk src",
    "test:e2e": "bun --conditions=development test --preload ./test/bun.e2e.setup.ts --max-concurrency 1 ./test/http-boundary.e2e-spec.ts",
    "test:watch": "bun --conditions=development test --watch src",
    "openapi:generate": "bun --conditions=development src/openapi/generate-effect-openapi.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:pull": "bunx drizzle-kit pull --config drizzle.config.ts",
    "db:migrate:dev": "bun src/database/drizzle/migrate.ts",
    "db:migrate:deploy": "bun src/database/drizzle/migrate.ts",
    "db:studio": "drizzle-kit studio --config drizzle.config.ts"
  },
  "dependencies": {
    "@discordjs/rest": "^2.6.3",
    "@effect/platform-bun": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@lootlog/datetime": "workspace:*",
    "@lootlog/domain": "workspace:*",
    "@lootlog/instrumentation": "workspace:*",
    "@lootlog/messaging": "workspace:*",
    "@lootlog/protocol": "workspace:*",
    "@lootlog/schema": "workspace:*",
    "bullmq": "^6.3.4",
    "discord-api-types": "0.38.54",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "sharp": "^0.35.4",
    "superjson": "catalog:",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@lootlog/typescript-config": "workspace:*",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "pg": "^8.23.0",
    "testcontainers": "^12.1.0",
    "typescript": "catalog:",
    "yaml": "catalog:"
  }
}
