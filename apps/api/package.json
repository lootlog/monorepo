{
  "name": "@lootlog/api",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "license": "MIT",
  "author": "",
  "scripts": {
    "prebuild": "pnpm api:generate",
    "build": "nest build",
    "format": "oxfmt src test",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start": "node --import ./dist/src/instrumentation.js dist/src/main.js",
    "lint": "oxlint src",
    "openapi:generate": "OPENAPI_GENERATION=true pnpm api:generate && OPENAPI_GENERATION=true nest build --config nest-cli.openapi.json && OPENAPI_GENERATION=true node --import ./dist/src/instrumentation.js dist/src/openapi/generate-openapi.js",
    "test": "vitest run --config ./vitest.config.ts",
    "test:watch": "vitest --config ./vitest.config.ts",
    "test:cov": "vitest run --config ./vitest.config.ts --coverage",
    "test:debug": "vitest --config ./vitest.config.ts --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "api:migrate:dev": "prisma migrate dev",
    "api:generate": "prisma generate",
    "api:studio": "prisma studio"
  },
  "dependencies": {
    "@discordjs/rest": "^2.6.1",
    "@fastify/static": "^9.1.2",
    "@golevelup/nestjs-rabbitmq": "^9.0.0",
    "@lootlog/api-helpers": "workspace:*",
    "@lootlog/instrumentation": "workspace:*",
    "@lootlog/nest-shared": "workspace:*",
    "@lootlog/types": "workspace:*",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.19",
    "@nestjs/core": "^11.1.19",
    "@nestjs/microservices": "^11.1.19",
    "@nestjs/platform-fastify": "^11.1.19",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.3.2",
    "@nestjs/websockets": "^11.1.19",
    "@prisma/adapter-pg": "7.6.0",
    "@prisma/client": "7.6.0",
    "axios": "^1.15.1",
    "bullmq": "^5.75.2",
    "discord-api-types": "0.38.31",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "ioredis": "^5.10.1",
    "js-yaml": "^4.1.1",
    "nest-winston": "^1.10.2",
    "nestjs-zod": "^5.3.0",
    "pg": "^8.20.0",
    "redlock": "5.0.0-beta.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.5",
    "uuid": "^14.0.0",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.21",
    "@nestjs/testing": "^11.1.19",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.33",
    "@testcontainers/postgresql": "^11.14.0",
    "@types/node": "^25.6.0",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.5",
    "prisma": "7.8.0",
    "supertest": "^7.2.2",
    "testcontainers": "^11.14.0",
    "typescript": "^6.0.3",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.5"
  }
