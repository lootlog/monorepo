{
  "name": "@lootlog/api",
  "version": "5.0.8",
  "private": true,
  "description": "",
  "license": "MIT",
  "author": "",
  "type": "module",
  "imports": {
    "#src/*": {
      "types": "./src/*.ts",
      "default": "./dist/src/*.js"
    }
  },
  "scripts": {
    "dev": "nest start --watch",
    "prebuild": "bun ../../tools/clean-swagger-metadata.mjs && bun run db:generate",
    "build": "nest build",
    "start": "bun --preload ./dist/src/instrumentation.js dist/src/main.js",
    "start:debug": "nest start --debug --watch",
    "lint": "oxlint src test",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "format": "oxfmt src test",
    "test": "vitest run --config ./vitest.config.ts",
    "test:coverage": "vitest run --config ./vitest.config.ts --coverage",
    "test:debug": "vitest --config ./vitest.config.ts --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:watch": "vitest --config ./vitest.config.ts",
    "openapi:generate": "OPENAPI_GENERATION=true bun run db:generate && OPENAPI_GENERATION=true nest build --config nest-cli.openapi.json && OPENAPI_GENERATION=true bun --preload ./dist/src/instrumentation.js dist/src/openapi/generate-openapi.js",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@discordjs/rest": "^2.6.3",
    "@fastify/static": "^10.1.3",
    "@golevelup/nestjs-rabbitmq": "^9.0.2",
    "@lootlog/access-policy": "workspace:*",
    "@lootlog/api-helpers": "workspace:*",
    "@lootlog/datetime": "workspace:*",
    "@lootlog/instrumentation": "workspace:*",
    "@lootlog/loot-visibility": "workspace:*",
    "@lootlog/nest-shared": "workspace:*",
    "@lootlog/reservations": "workspace:*",
    "@lootlog/scoring": "workspace:*",
    "@lootlog/types": "workspace:*",
    "@nestjs/axios": "catalog:",
    "@nestjs/bullmq": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-fastify": "catalog:",
    "@nestjs/schedule": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@nestjs/websockets": "catalog:",
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "axios": "^1.20.0",
    "bullmq": "^5.81.4",
    "discord-api-types": "0.38.54",
    "dotenv": "^17.4.2",
    "fastify": "5.12.1",
    "ioredis": "^5.11.1",
    "nest-winston": "catalog:",
    "nestjs-zod": "catalog:",
    "redlock": "5.0.0-beta.2",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "sharp": "^0.35.4",
    "superjson": "catalog:",
    "uuid": "^14.0.2",
    "winston": "^3.19.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@lootlog/typescript-config": "workspace:*",
    "@nestjs/cli": "catalog:",
    "@nestjs/schematics": "catalog:",
    "@nestjs/testing": "catalog:",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "catalog:",
    "pg": "^8.23.0",
    "prisma": "catalog:",
    "supertest": "^7.2.2",
    "testcontainers": "^12.1.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
