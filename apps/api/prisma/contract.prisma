    canView                Boolean      @default(true)
    canSend                Boolean      @default(true)
    hasRequiredPermissions Boolean      @default(false)
    requiredPermissions    String[]?    @noCheck(elementNotNull)
    grantedPermissions     String[]?    @noCheck(elementNotNull)
    missingPermissions     String[]?    @noCheck(elementNotNull)
    lastSyncedAt           Timestamp(3)
    createdAt              Timestamp(3) @default(now())
    updatedAt              Timestamp(3)
    guild                  Guild        @relation(fields:[guildId], references:[id], onDelete: Cascade, onUpdate: Cascade, map: "DiscordGuildChannelSnapshot_guildId_fkey", index: false)

    @@index([guildId, active, canSend], map: "DiscordGuildChannelSnapshot_guildId_active_canSend_idx")
    @@index([guildId, channelId], map: "DiscordGuildChannelSnapshot_guildId_channelId_key", unique: true)

    @@map("DiscordGuildChannelSnapshot")
  }

  model DiscordGuildSyncState {
