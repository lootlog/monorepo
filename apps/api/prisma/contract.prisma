  model DiscordGuildChannelSnapshot {
    id                     Int          @id(map: "DiscordGuildChannelSnapshot_pkey") @default(autoincrement())
    guildId                String
    channelId              String
    name                   String
    channelType            String
    parentId               String?
    position               Int
