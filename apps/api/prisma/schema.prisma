generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRESQL_CONNECTION_URI")
}

model Guild {
  id                String             @id
  name              String
  icon              String?
  ownerId           String
  vanityUrl         String?            @unique
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  roles             Role[]
  members           Member[]
  timers            Timer[]
  lootSubmissions   LootSubmission[]
  active            Boolean            @default(true)
  reservations      Reservation[]
  events            Event[]
  mapTemplates      MapTemplate[]

  @@index([vanityUrl])
}

enum Permission {
  OWNER
  ADMIN
  LOOTLOG_MANAGE
  LOOTLOG_ACCESS
  // Loots
  LOOTLOG_LOOTS_READ
  LOOTLOG_LOOTS_WRITE
  LOOTLOG_LOOTS_TITANS_READ
  LOOTLOG_LOOTS_HEROES_READ
  // Timers
  LOOTLOG_TIMERS_READ
  LOOTLOG_TIMERS_WRITE
  LOOTLOG_TIMERS_RESET
  LOOTLOG_TIMERS_DELETE
  LOOTLOG_TIMERS_TITANS_READ
  LOOTLOG_TIMERS_HEROES_READ
  // Reservations
  LOOTLOG_RESERVATIONS_READ
  LOOTLOG_RESERVATIONS_WRITE
  // Members
  LOOTLOG_MEMBERS_READ
  // Chat
  LOOTLOG_CHAT_READ
  LOOTLOG_CHAT_WRITE
  LOOTLOG_CHAT_TITANS_READ
  LOOTLOG_CHAT_HEROES_READ
  // Notifications
  LOOTLOG_NOTIFICATIONS_READ
  LOOTLOG_NOTIFICATIONS_SEND
  LOOTLOG_NOTIFICATIONS_TITANS_READ
  LOOTLOG_NOTIFICATIONS_HEROES_READ
}

enum MemberType {
  OWNER
  ADMIN
  USER
  BOT
}

enum NpcType {
  COMMON
  ELITE
  ELITE2
  ELITE3
  HERO
  EVENT_HERO
  TITAN
  COLOSSUS
  NPC
}

enum ItemType {
  ONE_HAND_WEAPON
  TWO_HAND_WEAPON
  ONE_AND_HALF_HAND_WEAPON
  DISTANCE_WEAPON
  HELP_WEAPON
  WAND_WEAPON
  ORB_WEAPON
  ARMOR
  HELMET
  BOOTS
  GLOVES
  RING
  NECKLACE
  SHIELD
  NEUTRAL
  CONSUME
  GOLD
  KEYS
  QUEST
  RENEWABLE
  ARROWS
  TALISMAN
  BOOK
  BAG
  BLESS
  UPGRADE
  RECIPE
  COINAGE
  QUIVER
  OUTFITS
  PETS
  TELEPORTS
}

enum ItemRarity {
  UNIQUE
  HEROIC
  LEGENDARY
  UPGRADED
}

enum Profession {
  WARRIOR
  PALADIN
  HUNTER
  MAGE
  BLADE_DANCER
  TRACKER
}

enum LootSource {
  LOOTBOX
  DIALOG
  FIGHT
}

enum RefreshJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Role {
  id           String       @id
  guildId      String
  name         String
  color        Int?
  position     Int?
  permissions  Permission[] @default([])
  lvlRangeFrom Int?         @default(0)
  lvlRangeTo   Int?         @default(500)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  guild   Guild    @relation(fields: [guildId], references: [id])
  members Member[]

  @@unique([id, guildId])
  @@index([id, guildId])
}

model Member {
  id                Int                @id @default(autoincrement())
  userId            String
  guildId           String
  type              MemberType         @default(USER)
  name              String
  avatar            String?
  banner            String?
  active            Boolean            @default(true)
  globalUserId      String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  guild                    Guild                      @relation(fields: [guildId], references: [id])
  roles                    Role[]
  timers                   Timer[]
  lootSubmissions          LootSubmission[]
  comments                 LootComment[]
  assignedEventMaps        EventMap[]
  eventPresenceLogs        EventPresenceLog[]
  eventKillPoints          EventKillPoint[]
  eventRankings            EventRanking[]
  detectedKills            EventHeroKill[]            @relation("KillDetectedBy")
  mapAssignmentHistory     EventMapAssignmentHistory[]

  @@unique(name: "memberId", [userId, guildId])
  @@index([id, guildId])
}

model Timer {
  createdById             Int
  guildId                 String
  npcId                   Int
  world                   String
  minSpawnTime            DateTime
  maxSpawnTime            DateTime
  latestRespBaseSeconds   Int      @default(0)
  latestRespawnRandomness Int      @default(0)
  tempId                  String?
  wasReset                Boolean  @default(false)
  npc                     Json
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  member Member @relation(fields: [createdById], references: [id])
  guild  Guild  @relation(fields: [guildId], references: [id])

  @@id(name: "timerId", [guildId, world, npcId])
  @@index([npcId, guildId])
  @@index([guildId, maxSpawnTime])
  @@index([world, guildId])
  @@index([createdById])
}

model Loot {
  id        Int        @id @default(autoincrement())
  uniqueId  String     @unique
  world     String
  source    LootSource
  location  String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  lootItems   LootItem[]
  lootNpcs    LootNpc[]
  lootPlayers LootPlayer[]

  lootSubmissions LootSubmission[]
  comments        LootComment[]
  lootShare       Json             @default("{}")

  @@index([createdAt])
  @@index([world, createdAt])
  @@index([world, id])
}

model ItemSnapshot {
  id            Int         @id @default(autoincrement())
  itemId        Int
  statsHash     String
  name          String
  icon          String
  lvl           Int?
  rarity        ItemRarity?
  itemType      String?
  statRaw       String
  statsSnapshot Json
  createdAt     DateTime    @default(now())

  lootItems LootItem[]

  @@unique([itemId, statsHash])
  @@index([rarity, lvl])
}

model LootItem {
  id             Int    @id @default(autoincrement())
  lootId         Int
  itemSnapshotId Int
  hid            String

  loot         Loot         @relation(fields: [lootId], references: [id])
  itemSnapshot ItemSnapshot @relation(fields: [itemSnapshotId], references: [id])

  @@index([lootId])
  @@index([itemSnapshotId])
}

model PlayerSnapshot {
  id           Int         @id @default(autoincrement())
  world        String
  accountId    Int
  characterId  Int
  snapshotHash String
  name         String
  prof         Profession?
  icon         String?
  createdAt    DateTime    @default(now())

  lootPlayers LootPlayer[]

  @@unique([world, accountId, characterId, snapshotHash])
  @@index([world, name])
  @@index([accountId, characterId])
  @@index([name])
}

model LootPlayer {
  id               Int  @id @default(autoincrement())
  lootId           Int
  playerSnapshotId Int
  lvl              Int?
  hpp              Int?

  loot           Loot           @relation(fields: [lootId], references: [id])
  playerSnapshot PlayerSnapshot @relation(fields: [playerSnapshotId], references: [id])

  @@index([lootId])
  @@index([playerSnapshotId])
}

model NpcSnapshot {
  id           Int         @id @default(autoincrement())
  npcId        Int
  name         String
  type         NpcType?
  lvl          Int?
  icon         String?
  wt           Int?
  margonemType Int?
  prof         Profession?
  createdAt    DateTime    @default(now())

  lootNpcs LootNpc[]

  @@unique([npcId, name])
  @@index([name])
  @@index([type, lvl])
}

model LootNpc {
  id            Int @id @default(autoincrement())
  lootId        Int
  npcSnapshotId Int

  loot        Loot        @relation(fields: [lootId], references: [id])
  npcSnapshot NpcSnapshot @relation(fields: [npcSnapshotId], references: [id])

  @@index([lootId])
  @@index([npcSnapshotId])
}

model LootSubmission {
  id        Int      @id @default(autoincrement())
  lootId    Int
  guildId   String
  memberId  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  loot   Loot   @relation(fields: [lootId], references: [id])
  member Member @relation(fields: [memberId], references: [id])
  guild  Guild  @relation(fields: [guildId], references: [id])

  @@unique([lootId, guildId, memberId])
  @@index([guildId, lootId])
}

model LootComment {
  id        Int      @id @default(autoincrement())
  lootId    Int
  memberId  Int
  guildId   String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  loot   Loot   @relation(fields: [lootId], references: [id])
  member Member @relation(fields: [memberId], references: [id])

  @@index([lootId])
}

model LootlogConfigNpc {
  id              Int          @id @default(autoincrement())
  lootlogConfigId String
  npcType         NpcType
  allowedRarities ItemRarity[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  lootlogConfig LootlogConfig @relation(fields: [lootlogConfigId], references: [id])
}

model LootlogConfig {
  id        String             @id
  npcs      LootlogConfigNpc[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model Reservation {
  id            Int      @id @default(autoincrement())
  guildId       String
  reservationId String
  createdDate   DateTime
  fromDate      DateTime
  toDate        DateTime
  createdBy     String
  comment       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id])

  @@index([guildId, reservationId])
  @@index([guildId, toDate])
}

model UserCharactersLootlogSettings {
  id                           Int      @id @default(autoincrement())
  userId                       String
  accountId                    String
  characterId                  String
  collectLootWhitelistGuildIds String[] @default([])
  addTimersWhitelistGuildIds   String[] @default([])
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  @@unique([userId, accountId, characterId])
}

model UserSettings {
  id          Int      @id @default(autoincrement())
  userId      String   @unique
  guildsOrder String[] @default([])
  theme       String   @default("default")
  colorMode   String   @default("dark")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model MemberRefreshJob {
  id               Int              @id @default(autoincrement())
  guildId          String
  requestedBy      String
  status           RefreshJobStatus @default(PENDING)
  totalMembers     Int              @default(0)
  processedMembers Int              @default(0)
  failedMembers    Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  completedAt      DateTime?

  @@index([guildId])
  @@index([status])
}

model UserTimerSettings {
  id                      Int      @id @default(autoincrement())
  userId                  String   @unique
  generalConfig           Json
  displayConfig           Json
  customColors            Json
  timersColors            Json
  defaultColorNames       Json
  overriddenDefaultColors Json
  hiddenDefaultColors     Json
  timerFiltersEnabled     Boolean  @default(true)
  colorFiltersEnabled     Boolean  @default(false)
  timersSortOrder         String   @default("asc")
  syncEnabled             Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([userId])
}

model UserGuildTimerSettings {
  id           Int      @id @default(autoincrement())
  userId       String
  guildId      String
  hiddenTimers String[] @default([])
  pinnedTimers String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, guildId])
  @@index([userId])
  @@index([guildId])
}

model UserSoundSettings {
  id                  Int      @id @default(autoincrement())
  userId              String   @unique
  masterVolume        Float    @default(0.5)
  notificationsVolume Float    @default(0.5)
  detectorVolume      Float    @default(0.5)
  timersVolume        Float    @default(0.5)
  notificationsConfig Json     @default("{}")
  detectorConfig      Json     @default("{}")
  timersConfig        Json     @default("{}")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId])
}

model Event {
  id        String    @id @default(cuid())
  guildId   String
  name      String
  world     String
  active    Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Scoring multipliers configuration
  basePointsPerKill        Int     @default(1) // Base points per kill before multipliers
  timeOfDayMultipliers     Json? // [{from: "06:00", to: "12:00", multiplier: 1.5}, ...]
  trackersMultipliers      Json? // {1: 3.0, 2: 2.5, 3: 2.0, 4: 1.5, 5: 1.0} - fewer trackers = higher multiplier
  mapsCountMultipliers     Json? // {1: 1.0, 2: 1.2, 3: 1.5, ...} - more maps = higher multiplier
  assignmentTimeoutMinutes Int     @default(5) // Minutes before minSpawnTime when assignments are allowed
  autoCalculatePoints      Boolean @default(true) // Whether to automatically calculate points on kill
  mapAssignmentCap         Int? // Maximum members per map (null or 0 = no limit)

  guild    Guild          @relation(fields: [guildId], references: [id])
  heroNpcs EventHeroNpc[]
  rankings EventRanking[]

  @@index([guildId, active])
  @@index([world])
}

model EventMapLocation {
  id        String   @id @default(cuid())
  heroNpcId String
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  heroNpc EventHeroNpc @relation(fields: [heroNpcId], references: [id], onDelete: Cascade)
  maps    EventMap[]

  @@unique([heroNpcId, name])
  @@index([heroNpcId, order])
}

model EventMap {
  id         String   @id @default(cuid())
  heroNpcId  String
  locationId String?
  mapId      Int
  mapName    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  heroNpc           EventHeroNpc                @relation(fields: [heroNpcId], references: [id], onDelete: Cascade)
  location          EventMapLocation?           @relation(fields: [locationId], references: [id], onDelete: SetNull)
  assignedMembers   Member[]
  presenceLogs      EventPresenceLog[]
  coverageGaps      EventMapCoverageGap[]
  assignmentHistory EventMapAssignmentHistory[]

  @@unique([heroNpcId, mapId])
  @@index([mapId])
  @@index([locationId])
}

enum CoverageGapType {
  UNASSIGNED // No member is assigned to the map
  UNCOVERED  // Members assigned but no one is present on the map
}

model EventMapCoverageGap {
  id              String          @id @default(cuid())
  mapId           String
  heroNpcId       String
  gapType         CoverageGapType
  startedAt       DateTime
  endedAt         DateTime?
  durationSeconds Int?

  map     EventMap     @relation(fields: [mapId], references: [id], onDelete: Cascade)
  heroNpc EventHeroNpc @relation(fields: [heroNpcId], references: [id], onDelete: Cascade)

  @@index([mapId, gapType, endedAt])
  @@index([heroNpcId, endedAt])
}

model EventMapAssignmentHistory {
  id           String    @id @default(cuid())
  mapId        String
  heroNpcId    String
  memberId     Int
  assignedAt   DateTime  @default(now())
  unassignedAt DateTime?

  map     EventMap     @relation(fields: [mapId], references: [id], onDelete: Cascade)
  heroNpc EventHeroNpc @relation(fields: [heroNpcId], references: [id], onDelete: Cascade)
  member  Member       @relation(fields: [memberId], references: [id])

  @@index([mapId, assignedAt])
  @@index([heroNpcId, assignedAt])
  @@index([memberId])
}

model EventHeroNpc {
  id        String   @id @default(cuid())
  eventId   String
  npcId     Int?
  npcName   String
  npcIcon   String?
  createdAt DateTime @default(now())

  event             Event                       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  kills             EventHeroKill[]
  maps              EventMap[]
  locations         EventMapLocation[]
  coverageGaps      EventMapCoverageGap[]
  assignmentHistory EventMapAssignmentHistory[]

  @@unique([eventId, npcName])
  @@index([npcId])
}

model EventPresenceLog {
  id        String    @id @default(cuid())
  mapId     String
  memberId  Int
  isAfk     Boolean
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  map    EventMap @relation(fields: [mapId], references: [id], onDelete: Cascade)
  member Member   @relation(fields: [memberId], references: [id])

  @@index([mapId, memberId])
  @@index([startedAt, endedAt])
}

model EventHeroKill {
  id                 String   @id @default(cuid())
  heroNpcId          String
  killedAt           DateTime @default(now())
  minSpawnTimeAtKill DateTime // Respawn window min at time of kill
  maxSpawnTimeAtKill DateTime // Respawn window max at time of kill
  timerCreatedById   Int? // Member who submitted the timer (detected the kill)
  isManualClose      Boolean  @default(false) // True if this was a manual window close, not an actual kill

  heroNpc        EventHeroNpc     @relation(fields: [heroNpcId], references: [id], onDelete: Cascade)
  timerCreatedBy Member?          @relation("KillDetectedBy", fields: [timerCreatedById], references: [id])
  points         EventKillPoint[]

  @@index([heroNpcId])
  @@index([killedAt])
}

model EventKillPoint {
  id                String   @id @default(cuid())
  killId            String
  memberId          Int
  mapName           String
  basePoints        Int // Points before multipliers
  points            Int // Final points after multipliers
  appliedMultiplier Float // Combined multiplier applied
  timeOnMapSeconds  Int
  afkPercentage     Float
  wasPresent        Boolean
  createdAt         DateTime @default(now())

  kill   EventHeroKill @relation(fields: [killId], references: [id], onDelete: Cascade)
  member Member        @relation(fields: [memberId], references: [id])

  @@unique([killId, memberId, mapName])
  @@index([memberId])
}

model EventRanking {
  id               String   @id @default(cuid())
  eventId          String
  memberId         Int
  heroNpcName      String
  totalPoints      Int      @default(0)
  totalKills       Int      @default(0)
  totalTimeSeconds Int      @default(0)
  avgAfkPercentage Float    @default(0)
  pointsModified   Boolean  @default(false)
  updatedAt        DateTime @updatedAt

  event       Event                     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member      Member                    @relation(fields: [memberId], references: [id])
  editHistory EventPointsEditHistory[]

  @@unique([eventId, memberId, heroNpcName])
  @@index([eventId, totalPoints(sort: Desc)])
}

enum PointsEditType {
  KILL_POINT
  RANKING
}

model EventPointsEditHistory {
  id             String         @id @default(cuid())
  rankingId      String
  previousPoints Int
  newPoints      Int
  editType       PointsEditType
  editedByUserId String
  editedAt       DateTime       @default(now())

  ranking EventRanking @relation(fields: [rankingId], references: [id], onDelete: Cascade)

  @@index([rankingId, editedAt(sort: Desc)])
}

model MapTemplate {
  id        String   @id @default(cuid())
  guildId   String
  name      String
  maps      Json     // [{ id: number, name: string }]
  createdAt DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id])

  @@unique([guildId, name])
  @@index([guildId])
}
