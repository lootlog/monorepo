generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRESQL_CONNECTION_URI")
}


enum Permission {
  OWNER
  ADMIN
  LOOTLOG_MANAGE
  LOOTLOG_READ
  LOOTLOG_WRITE
  LOOTLOG_READ_TIMERS_TITANS
  LOOTLOG_READ_LOOTS_TITANS
  LOOTLOG_READ_TIMERS_HEROES
  LOOTLOG_READ_LOOTS_HEROES
  LOOTLOG_CHAT_READ
  LOOTLOG_CHAT_WRITE
  LOOTLOG_NOTIFICATIONS_SEND
  LOOTLOG_NOTIFICATIONS_READ
}

enum MemberType {
  OWNER
  ADMIN
  USER
  BOT
}

enum NpcType {
  COMMON
  ELITE
  ELITE2
  ELITE3
  HERO
  EVENT_HERO
  TITAN
  COLOSSUS
  NPC
}

enum ItemType {
  ONE_HAND_WEAPON
  TWO_HAND_WEAPON
  ONE_AND_HALF_HAND_WEAPON
  DISTANCE_WEAPON
  HELP_WEAPON
  WAND_WEAPON
  ORB_WEAPON
  ARMOR
  HELMET
  BOOTS
  GLOVES
  RING
  NECKLACE
  SHIELD
  NEUTRAL
  CONSUME
  GOLD
  KEYS
  QUEST
  RENEWABLE
  ARROWS
  TALISMAN
  BOOK
  BAG
  BLESS
  UPGRADE
  RECIPE
  COINAGE
  QUIVER
  OUTFITS
  PETS
  TELEPORTS
}

enum ItemRarity {
  UNIQUE
  HEROIC
  LEGENDARY
  UPGRADED
}

enum Profession {
  WARRIOR
  PALADIN
  HUNTER
  MAGE
  BLADE_DANCER
  TRACKER
}

enum LootSource {
  LOOTBOX
  DIALOG
  FIGHT
}

enum RefreshJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}


model Guild {
  id              String           @id
  name            String
  icon            String?
  ownerId         String
  vanityUrl       String?          @unique
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  roles           Role[]
  members         Member[]
  timers          Timer[]
  lootSubmissions LootSubmission[]

  @@index([vanityUrl])
}

model Role {
  id           String       @id
  guildId      String
  name         String
  color        Int?
  position     Int?
  permissions  Permission[] @default([])
  lvlRangeFrom Int?         @default(0)
  lvlRangeTo   Int?         @default(500)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  guild   Guild    @relation(fields: [guildId], references: [id])
  members Member[]

  @@unique([id, guildId])
  @@index([id, guildId])
}

model Member {
  id              Int              @id @default(autoincrement())
  userId          String
  guildId         String
  type            MemberType       @default(USER)
  name            String
  avatar          String?
  banner          String?
  active          Boolean          @default(true)
  globalUserId    String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  guild           Guild            @relation(fields: [guildId], references: [id])
  roles           Role[]
  timers          Timer[]
  lootSubmissions LootSubmission[]
  comments        LootComment[]

  @@unique(name: "memberId", [userId, guildId])
  @@index([id, guildId])
}

model Timer {
  createdById             Int
  guildId                 String
  npcId                   Int
  world                   String
  minSpawnTime            DateTime
  maxSpawnTime            DateTime
  latestRespBaseSeconds   Int      @default(0)
  latestRespawnRandomness Int      @default(0)
  tempId                  String?
  wasReset                Boolean  @default(false)
  npc                     Json
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  member Member @relation(fields: [createdById], references: [id])
  guild  Guild  @relation(fields: [guildId], references: [id])

  @@id(name: "timerId", [guildId, world, npcId])
  @@index([npcId, guildId])
  @@index([guildId, maxSpawnTime])
  @@index([world, guildId])
  @@index([createdById])
}


model Loot {
  id        Int        @id @default(autoincrement())
  uniqueId  String     @unique
  world     String
  source    LootSource
  location  String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  mainNpcName  String?
  mainNpcType  NpcType?
  itemRarities ItemRarity[]
  playerNames  String[]     @default([])

  items   Json?
  players Json?
  npcs    Json?

  lootItems   LootItem[]
  lootNpcs    LootNpc[]
  lootPlayers LootPlayer[]

  lootSubmissions LootSubmission[]
  comments        LootComment[]
  lootShare       Json             @default("{}")

  @@index([createdAt])
  @@index([uniqueId])
  @@index([world, source, createdAt])
  @@index([mainNpcName])
  @@index([itemRarities], type: Gin)
}

model ItemSnapshot {
  id            Int         @id @default(autoincrement())
  itemId        Int
  statsHash     String
  name          String
  icon          String
  lvl           Int?
  rarity        ItemRarity?
  itemType      String?
  statRaw       String
  statsSnapshot Json
  createdAt     DateTime    @default(now())

  lootItems LootItem[]

  @@unique([itemId, statsHash])
  @@index([statsSnapshot], type: Gin)
  @@index([rarity, lvl])
}

model LootItem {
  id             Int @id @default(autoincrement())
  lootId         Int
  itemSnapshotId Int

  loot         Loot         @relation(fields: [lootId], references: [id])
  itemSnapshot ItemSnapshot @relation(fields: [itemSnapshotId], references: [id])

  @@index([lootId])
  @@index([itemSnapshotId])
}

model PlayerSnapshot {
  id           Int         @id @default(autoincrement())
  world        String
  accountId    String
  characterId  String
  snapshotHash String
  name         String
  lvl          Int
  prof         Profession?
  icon         String?
  createdAt    DateTime    @default(now())

  lootPlayers LootPlayer[]

  @@unique([world, accountId, characterId, snapshotHash])
  @@index([world, name])
  @@index([accountId, characterId])
}

model LootPlayer {
  id               Int  @id @default(autoincrement())
  lootId           Int
  playerSnapshotId Int
  hpp              Int?

  loot           Loot           @relation(fields: [lootId], references: [id])
  playerSnapshot PlayerSnapshot @relation(fields: [playerSnapshotId], references: [id])

  @@index([lootId])
  @@index([playerSnapshotId])
}

model NpcSnapshot {
  id        Int      @id @default(autoincrement())
  npcId     Int
  name      String
  type      NpcType?
  lvl       Int?
  icon      String?
  createdAt DateTime @default(now())

  lootNpcs LootNpc[]

  @@unique([npcId, name])
}

model LootNpc {
  id            Int @id @default(autoincrement())
  lootId        Int
  npcSnapshotId Int

  loot        Loot        @relation(fields: [lootId], references: [id])
  npcSnapshot NpcSnapshot @relation(fields: [npcSnapshotId], references: [id])

  @@index([lootId])
  @@index([npcSnapshotId])
}


model LootSubmission {
  id        Int      @id @default(autoincrement())
  lootId    Int
  guildId   String
  memberId  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  loot   Loot   @relation(fields: [lootId], references: [id])
  member Member @relation(fields: [memberId], references: [id])
  guild  Guild  @relation(fields: [guildId], references: [id])

  @@unique([lootId, guildId, memberId])
}

model LootComment {
  id        Int      @id @default(autoincrement())
  lootId    Int
  memberId  Int
  guildId   String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  loot   Loot   @relation(fields: [lootId], references: [id])
  member Member @relation(fields: [memberId], references: [id])

  @@index([lootId])
}

model LootlogConfigNpc {
  id              Int          @id @default(autoincrement())
  lootlogConfigId String
  npcType         NpcType
  allowedRarities ItemRarity[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  lootlogConfig LootlogConfig @relation(fields: [lootlogConfigId], references: [id])
}

model LootlogConfig {
  id        String             @id
  npcs      LootlogConfigNpc[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model UserCharactersLootlogSettings {
  id                           Int      @id @default(autoincrement())
  userId                       String
  accountId                    String
  characterId                  String
  collectLootWhitelistGuildIds String[] @default([])
  addTimersWhitelistGuildIds   String[] @default([])
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  @@unique([userId, accountId, characterId])
}

model UserSettings {
  id          Int      @id @default(autoincrement())
  userId      String   @unique
  guildsOrder String[] @default([])
  theme       String   @default("default")
  colorMode   String   @default("dark")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model MemberRefreshJob {
  id               Int              @id @default(autoincrement())
  guildId          String
  requestedBy      String
  status           RefreshJobStatus @default(PENDING)
  totalMembers     Int              @default(0)
  processedMembers Int              @default(0)
  failedMembers    Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  completedAt      DateTime?

  @@index([guildId])
  @@index([status])
}

model UserTimerSettings {
  id                      Int      @id @default(autoincrement())
  userId                  String   @unique
  generalConfig           Json
  displayConfig           Json
  customColors            Json
  timersColors            Json
  defaultColorNames       Json
  overriddenDefaultColors Json
  hiddenDefaultColors     Json
  timerFiltersEnabled     Boolean  @default(true)
  colorFiltersEnabled     Boolean  @default(false)
  timersSortOrder         String   @default("asc")
  syncEnabled             Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([userId])
}

model UserGuildTimerSettings {
  id           Int      @id @default(autoincrement())
  userId       String
  guildId      String
  hiddenTimers String[] @default([])
  pinnedTimers String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, guildId])
  @@index([userId])
  @@index([guildId])
}
