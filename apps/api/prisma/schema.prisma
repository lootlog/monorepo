generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Guild {
  id                String             @id
  name              String
  icon              String?
  ownerId           String
  vanityUrl         String?            @unique
  notificationRuleLimit Int            @default(20)
  publicStatsCardEnabled Boolean       @default(false)
  reservationMaxDurationMinutes Int    @default(180)
  reservationMinDurationMinutes Int    @default(30)
  reservationTimeGranularityMinutes Int @default(15)
  reservationMaxAdvanceDays Int         @default(7)
  reservationActiveLimitPerSpot Int     @default(3)
  documentLimit     Int                @default(50)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  roles             Role[]
  members           Member[]
  timers            Timer[]
  timerHistoryEntries TimerHistoryEntry[]
  lootSubmissions   LootSubmission[]
  active            Boolean            @default(true)
  reservations      Reservation[]
  events            Event[]
  mapTemplates      MapTemplate[]
  npcKillStats      NpcKillStats[]
  npcKillStatsBuckets NpcKillStatsBucket[]
  guildKillSummary  GuildKillSummary[]
  guildKillSummaryBuckets GuildKillSummaryBucket[]
  notificationRules NotificationRule[]
  discordChannelSnapshots DiscordGuildChannelSnapshot[]
  discordSyncState  DiscordGuildSyncState?
  documents         GuildDocument[]
  documentHistory   GuildDocumentHistory[]

  @@index([vanityUrl])
}

enum Permission {
  OWNER
  ADMIN
  LOOTLOG_MANAGE
  LOOTLOG_ACCESS
  LOOTLOG_LOOTS_READ
  LOOTLOG_LOOTS_WRITE
  LOOTLOG_LOOTS_TITANS_READ
  LOOTLOG_LOOTS_HEROES_READ
  LOOTLOG_TIMERS_READ
  LOOTLOG_TIMERS_WRITE
  LOOTLOG_TIMERS_RESET
  LOOTLOG_TIMERS_DELETE
  LOOTLOG_TIMERS_TITANS_READ
  LOOTLOG_TIMERS_HEROES_READ
  LOOTLOG_RESERVATIONS_READ
  LOOTLOG_RESERVATIONS_WRITE
  LOOTLOG_MEMBERS_READ
  LOOTLOG_ONLINE_PLAYERS_READ
  LOOTLOG_CHAT_READ
  LOOTLOG_CHAT_WRITE
  LOOTLOG_CHAT_TITANS_READ
  LOOTLOG_CHAT_HEROES_READ
  LOOTLOG_NOTIFICATIONS_READ
  LOOTLOG_NOTIFICATIONS_SEND
  LOOTLOG_NOTIFICATIONS_TITANS_READ
  LOOTLOG_NOTIFICATIONS_HEROES_READ
  LOOTLOG_EVENTS_MANAGE
  LOOTLOG_EVENTS_READ
  LOOTLOG_EVENTS_WRITE
  LOOTLOG_DOCS_READ
  LOOTLOG_DOCS_WRITE
}

enum MemberType {
  OWNER
  ADMIN
  USER
  BOT
}

enum NpcType {
  COMMON
  ELITE
  ELITE2
  ELITE3
  HERO
  EVENT_HERO
  TITAN
  COLOSSUS
  NPC
}

enum ItemType {
  ONE_HAND_WEAPON
  TWO_HAND_WEAPON
  ONE_AND_HALF_HAND_WEAPON
  DISTANCE_WEAPON
  HELP_WEAPON
  WAND_WEAPON
  ORB_WEAPON
  ARMOR
  HELMET
  BOOTS
  GLOVES
  RING
  NECKLACE
  SHIELD
  NEUTRAL
  CONSUME
  GOLD
  KEYS
  QUEST
  RENEWABLE
  ARROWS
  TALISMAN
  BOOK
  BAG
  BLESS
  UPGRADE
  RECIPE
  COINAGE
  QUIVER
  OUTFITS
  PETS
  TELEPORTS
}

enum ItemRarity {
  UNIQUE
  HEROIC
  LEGENDARY
  UPGRADED
}

enum Profession {
  WARRIOR
  PALADIN
  HUNTER
  MAGE
  BLADE_DANCER
  TRACKER
}

enum LootSource {
  LOOTBOX
  DIALOG
  FIGHT
}

enum TimerHistoryAction {
  CREATE
  RESET
  DELETE
  RESTORE
}

enum GuildDocumentHistoryAction {
  SAVE
  DELETE
  RESTORE
}

enum RefreshJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum NotificationOwnerType {
  GUILD
  USER
}

enum NotificationProvider {
  DISCORD
}

enum NotificationTargetType {
  CHANNEL
  DM
}

enum NotificationTriggerType {
  TIMER_BEFORE_SPAWN
  NPC_SPAWNED
  WATCHED_ITEM_DROPPED
  SCHEDULED_MESSAGE
}

enum NotificationScheduleStrategy {
  SPAWN_WINDOW_RELATIVE
  FIXED_DATETIME
}

enum SettingsScopeType {
  USER
  GAME_ACCOUNT
  CHARACTER
  GUILD
}

enum NotificationScheduleAnchor {
  MIN_SPAWN
  MAX_SPAWN
}

enum NotificationScheduleIntervalType {
  ONCE
  HOURLY
  DAILY
  WEEKLY
}

enum NotificationJobKind {
  SCHEDULED
  INSTANT
  TEST
}

enum NotificationJobStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  BLOCKED
  CANCELED
}

enum DiscordGuildSyncStatus {
  SYNCED
  SYNCING
  FAILED
  STALE
  NOT_FOUND
}

model Role {
  id           String       @id
  guildId      String
  name         String
  color        Int?
  position     Int?
  permissions  Permission[] @default([])
  lvlRangeFrom Int?         @default(0)
  lvlRangeTo   Int?         @default(500)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  guild   Guild    @relation(fields: [guildId], references: [id])
  members Member[]

  @@unique([id, guildId])
  @@index([id, guildId])
}

model Member {
  id                Int                @id @default(autoincrement())
  userId            String
  guildId           String
  type              MemberType         @default(USER)
  name              String
  avatar            String?
  banner            String?
  active            Boolean            @default(true)
  globalUserId      String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  lastDiscordSyncAt DateTime?
  lastDiscordAttemptAt DateTime?
  lastDiscordStatus String?
  guild                    Guild                      @relation(fields: [guildId], references: [id])
  roles                    Role[]
  timers                   Timer[]
  timerHistoryEntries      TimerHistoryEntry[]
  restoredTimerHistoryEntries TimerHistoryEntry[] @relation("TimerHistoryRestoredTimerMember")
  lootSubmissions          LootSubmission[]
  comments                 LootComment[]
  assignedEventMaps        EventMap[]
  eventPresenceLogs        EventPresenceLog[]
  eventKillPoints          EventKillPoint[]
  eventRankings            EventRanking[]
  detectedKills            EventHeroKill[]            @relation("KillDetectedBy")
  mapAssignmentHistory     EventMapAssignmentHistory[]
  npcKillStats             NpcKillStats[]
  npcKillStatsBuckets      NpcKillStatsBucket[]

  @@unique(name: "memberId", [userId, guildId])
  @@index([id, guildId])
  @@index([userId, guildId, active, lastDiscordSyncAt])
}

model Timer {
  createdById             Int
  guildId                 String
  npcId                   Int
  timerKey                String
  world                   String
  minSpawnTime            DateTime
  maxSpawnTime            DateTime
  latestRespBaseSeconds   Int      @default(0)
  latestRespawnRandomness Int      @default(0)
  tempId                  String?
  wasReset                Boolean  @default(false)
  npc                     Json
  windowOpenedAt          DateTime?
  actorCharacterSnapshotId Int?
  actorCharacterLvl       Int?
  deletedAt               DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  member         Member          @relation(fields: [createdById], references: [id])
  guild          Guild           @relation(fields: [guildId], references: [id])
  actorCharacter PlayerSnapshot? @relation("TimerActorCharacter", fields: [actorCharacterSnapshotId], references: [id])

  @@id(name: "timerId", [guildId, world, timerKey])
  @@index([guildId, world, timerKey])
  @@index([npcId, guildId])
  @@index([guildId, maxSpawnTime])
  @@index([guildId, world, deletedAt, maxSpawnTime])
  @@index([world, guildId])
  @@index([createdById])
  @@index([actorCharacterSnapshotId])
}

model Loot {
  id        Int        @id @default(autoincrement())
  uniqueId  String     @unique
  world     String
  source    LootSource
  location  String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  lootItems   LootItem[]
  lootNpcs    LootNpc[]
  lootPlayers LootPlayer[]

  lootSubmissions LootSubmission[]
  comments        LootComment[]
  lootShare       Json             @default("{}")

  @@index([createdAt])
  @@index([world, createdAt])
  @@index([world, id])
}

model ItemSnapshot {
  id            Int         @id @default(autoincrement())
  itemId        Int
  statsHash     String
  name          String
  icon          String
  lvl           Int?
  rarity        ItemRarity?
  itemType      String?
  statRaw       String
  statsSnapshot Json
  createdAt     DateTime    @default(now())

  lootItems LootItem[]

  @@unique([itemId, statsHash])
  @@index([name])
  @@index([rarity, lvl])
}

model LootItem {
  id             Int    @id @default(autoincrement())
  lootId         Int
  itemSnapshotId Int
  hid            String

  loot         Loot         @relation(fields: [lootId], references: [id])
  itemSnapshot ItemSnapshot @relation(fields: [itemSnapshotId], references: [id])

  @@index([lootId, itemSnapshotId])
  @@index([hid, lootId])
  @@index([itemSnapshotId, lootId])
}

model PlayerSnapshot {
  id           Int         @id @default(autoincrement())
  world        String
  accountId    Int
  characterId  Int
  snapshotHash String
  name         String
  prof         Profession?
  icon         String?
  createdAt    DateTime    @default(now())

  lootPlayers           LootPlayer[]
  timerActorCharacters  Timer[]             @relation("TimerActorCharacter")
  timerHistoryEntries   TimerHistoryEntry[]
  restoredTimerHistoryEntries TimerHistoryEntry[] @relation("TimerHistoryRestoredTimerActorCharacter")

  @@unique([world, accountId, characterId, snapshotHash])
  @@index([world, name])
  @@index([accountId, characterId])
  @@index([name])
}

model TimerHistoryEntry {
  id                       Int                @id @default(autoincrement())
  guildId                  String
  world                    String
  timerKey                 String
  npcId                    Int
  npc                      Json
  action                   TimerHistoryAction
  actorMemberId            Int
  actorCharacterSnapshotId Int?
  actorCharacterLvl        Int?
  minSpawnTime             DateTime?
  maxSpawnTime             DateTime?
  latestRespBaseSeconds    Int?
  latestRespawnRandomness  Int?
  wasReset                 Boolean?
  windowOpenedAt           DateTime?
  timerCreatedById         Int?
  timerActorCharacterSnapshotId Int?
  timerActorCharacterLvl   Int?
  createdAt                DateTime           @default(now())

  guild               Guild           @relation(fields: [guildId], references: [id])
  actorMember         Member          @relation(fields: [actorMemberId], references: [id])
  actorCharacter      PlayerSnapshot? @relation(fields: [actorCharacterSnapshotId], references: [id])
  timerCreatedBy      Member?         @relation("TimerHistoryRestoredTimerMember", fields: [timerCreatedById], references: [id])
  timerActorCharacter PlayerSnapshot? @relation("TimerHistoryRestoredTimerActorCharacter", fields: [timerActorCharacterSnapshotId], references: [id])

  @@index([guildId, world, timerKey, createdAt])
  @@index([guildId, world, createdAt])
  @@index([actorMemberId])
  @@index([actorCharacterSnapshotId])
  @@index([timerCreatedById])
  @@index([timerActorCharacterSnapshotId])
}

model LootPlayer {
  id               Int  @id @default(autoincrement())
  lootId           Int
  playerSnapshotId Int
  lvl              Int?
  hpp              Int?

  loot           Loot           @relation(fields: [lootId], references: [id])
  playerSnapshot PlayerSnapshot @relation(fields: [playerSnapshotId], references: [id])

  @@index([lootId])
  @@index([playerSnapshotId])
}

model NpcSnapshot {
  id           Int         @id @default(autoincrement())
  npcId        Int
  name         String
  type         NpcType?
  lvl          Int?
  icon         String?
  wt           Int?
  margonemType Int?
  prof         Profession?
  createdAt    DateTime    @default(now())

  lootNpcs LootNpc[]

  @@unique([npcId, name])
  @@index([name])
  @@index([type, lvl])
}

model LootNpc {
  id            Int @id @default(autoincrement())
  lootId        Int
  npcSnapshotId Int

  loot        Loot        @relation(fields: [lootId], references: [id])
  npcSnapshot NpcSnapshot @relation(fields: [npcSnapshotId], references: [id])

  @@index([lootId])
  @@index([npcSnapshotId])
}

model LootSubmission {
  id        Int      @id @default(autoincrement())
  lootId    Int
  guildId   String
  memberId  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  loot   Loot   @relation(fields: [lootId], references: [id])
  member Member @relation(fields: [memberId], references: [id])
  guild  Guild  @relation(fields: [guildId], references: [id])

  @@unique([lootId, guildId, memberId])
  @@index([guildId, lootId])
}

model LootComment {
  id        Int      @id @default(autoincrement())
  lootId    Int
  memberId  Int
  guildId   String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  loot   Loot   @relation(fields: [lootId], references: [id])
  member Member @relation(fields: [memberId], references: [id])

  @@index([lootId])
  @@index([lootId, guildId])
}

model LootlogConfigNpc {
  id              Int          @id @default(autoincrement())
  lootlogConfigId String
  npcType         NpcType
  allowedRarities ItemRarity[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  lootlogConfig LootlogConfig @relation(fields: [lootlogConfigId], references: [id])
}

model LootlogConfig {
  id        String             @id
  npcs      LootlogConfigNpc[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model Reservation {
  id            Int      @id @default(autoincrement())
  guildId       String
  reservationId String
  createdDate   DateTime
  fromDate      DateTime
  toDate        DateTime
  createdBy     String
  comment       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id])

  @@index([guildId, reservationId])
  @@index([guildId, toDate])
}

model UserCharactersLootlogSettings {
  id               Int      @id @default(autoincrement())
  userId           String
  accountId        String
  characterId      String
  catchingGuildIds String[] @default([])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, accountId, characterId])
}

model UserSettings {
  id          Int      @id @default(autoincrement())
  userId      String   @unique
  guildsOrder String[] @default([])
  theme       String   @default("default")
  colorMode   String   @default("dark")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model UserSettingDocument {
  id            Int               @id @default(autoincrement())
  userId        String
  domain        String
  scopeType     SettingsScopeType
  scopeId       String
  overrides     Json               @default("{}")
  schemaVersion Int                @default(1)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([userId, domain, scopeType, scopeId])
  @@index([userId, domain])
  @@index([userId, scopeType, scopeId])
}

model UserGameAccountSettings {
  id        Int      @id @default(autoincrement())
  userId    String
  accountId String
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, accountId])
  @@index([userId])
}

model NotificationTarget {
  id                Int             @id @default(autoincrement())
  ownerType         NotificationOwnerType
  ownerId           String
  provider          NotificationProvider
  targetType        NotificationTargetType
  externalId        String
  displayName       String?
  guildName         String?
  metadata          Json?
  active            Boolean         @default(true)
  canSend           Boolean         @default(true)
  lastSyncedAt      DateTime?
  lastDeliveryAt    DateTime?
  lastDeliveryError String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  rules NotificationRuleTarget[]
  jobs  NotificationJob[]

  @@unique([ownerType, ownerId, provider, targetType, externalId])
  @@index([ownerType, ownerId, active])
}

model NotificationRule {
  id                  Int              @id @default(autoincrement())
  ownerType           NotificationOwnerType
  ownerId             String
  triggerType         NotificationTriggerType
  guildId             String?
  world               String?
  name                String?
  filters             Json?
  contentTemplate     String?
  scheduleStrategy    NotificationScheduleStrategy?
  scheduleAnchor      NotificationScheduleAnchor?
  scheduleOffsetMinutes Int?
  scheduledAt         DateTime?
  scheduleIntervalType NotificationScheduleIntervalType?
  scheduleIntervalValue Int?
  scheduleWeekday     Int?
  scheduleTimeOfDay   String?
  scheduledUntil      DateTime?
  scheduleTimezone    String?
  enabled             Boolean          @default(true)
  dedupeWindowSeconds Int              @default(0)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  guild              Guild?                  @relation(fields: [guildId], references: [id])
  targets            NotificationRuleTarget[]
  jobs               NotificationJob[]
  watchedItems  WatchedItem[]

  @@index([ownerType, ownerId, enabled])
  @@index([guildId, world, triggerType, enabled])
}

model NotificationRuleTarget {
  ruleId     Int
  targetId   Int
  createdAt  DateTime @default(now())

  rule   NotificationRule   @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  target NotificationTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@id([ruleId, targetId])
  @@index([targetId])
}

model NotificationJob {
  id               String         @id
  ruleId           Int
  targetId         Int
  ownerType        NotificationOwnerType
  ownerId          String
  jobKind          NotificationJobKind
  scheduledFor     DateTime
  status           NotificationJobStatus @default(PENDING)
  idempotencyKey   String         @unique
  sourceEntityType String?
  sourceEntityId   String?
  sourceEventId    String?
  payloadSnapshot  Json
  attemptCount     Int            @default(0)
  lastError        String?
  blockedReason    String?
  providerMessageId String?
  processedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  rule   NotificationRule   @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  target NotificationTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@index([ruleId, status])
  @@index([targetId, status])
  @@index([ownerType, ownerId, status, scheduledFor])
  @@index([status, scheduledFor])
}

model WatchedItem {
  id          Int      @id @default(autoincrement())
  userId      String
  itemId      Int
  itemName    String
  world       String
  enabled     Boolean  @default(true)
  notificationRuleId Int?     @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  notificationRule NotificationRule? @relation(fields: [notificationRuleId], references: [id], onDelete: SetNull)

  @@unique([userId, itemId, world])
  @@index([userId, enabled])
  @@index([itemId, world, enabled])
}

model DiscordGuildChannelSnapshot {
  id           Int      @id @default(autoincrement())
  guildId      String
  channelId    String
  name         String
  channelType  String
  parentId     String?
  position     Int
  active       Boolean  @default(true)
  canView      Boolean  @default(true)
  canSend      Boolean  @default(true)
  hasRequiredPermissions Boolean @default(false)
  requiredPermissions    String[] @default([])
  grantedPermissions     String[] @default([])
  missingPermissions     String[] @default([])
  lastSyncedAt DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, channelId])
  @@index([guildId, active, canSend])
}

model DiscordGuildSyncState {
  guildId                String                  @id
  status                 DiscordGuildSyncStatus  @default(STALE)
  hasRequiredPermissions Boolean                 @default(false)
  requiredPermissions    String[]                @default([])
  grantedPermissions     String[]                @default([])
  missingPermissions     String[]                @default([])
  channelCount           Int                     @default(0)
  selectableChannelCount Int                     @default(0)
  lastAttemptAt          DateTime?
  lastSuccessAt          DateTime?
  lastError              String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

model MemberRefreshJob {
  id               Int              @id @default(autoincrement())
  guildId          String
  requestedBy      String
  status           RefreshJobStatus @default(PENDING)
  totalMembers     Int              @default(0)
  processedMembers Int              @default(0)
  failedMembers    Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  completedAt      DateTime?

  @@index([guildId])
  @@index([status])
}

model UserTimerSettings {
  id                      Int      @id @default(autoincrement())
  userId                  String   @unique
  generalConfig           Json
  displayConfig           Json
  customColors            Json
  timersColors            Json
  alwaysVisibleExpiredTimers Json @default("{}")
  defaultColorNames       Json
  overriddenDefaultColors Json
  hiddenDefaultColors     Json
  timerFiltersEnabled     Boolean  @default(true)
  colorFiltersEnabled     Boolean  @default(false)
  timersSortOrder         String   @default("asc")
  syncEnabled             Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([userId])
}

model UserGuildTimerSettings {
  id           Int      @id @default(autoincrement())
  userId       String
  guildId      String
  hiddenTimers String[] @default([])
  pinnedTimers String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, guildId])
  @@index([userId])
  @@index([guildId])
}

model UserGuildEventSettings {
  id           Int      @id @default(autoincrement())
  userId       String
  guildId      String
  pinnedEvents String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, guildId])
  @@index([userId])
  @@index([guildId])
}

model UserSoundSettings {
  id                  Int      @id @default(autoincrement())
  userId              String   @unique
  masterVolume        Float    @default(0.5)
  notificationsVolume Float    @default(0.5)
  detectorVolume      Float    @default(0.5)
  timersVolume        Float    @default(0.5)
  pingsVolume         Float    @default(0)
  notificationsConfig Json     @default("{}")
  detectorConfig      Json     @default("{}")
  timersConfig        Json     @default("{}")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId])
}

model Event {
  id        String    @id @default(cuid())
  guildId   String
  name      String
  world     String
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  basePointsPerKill                Int              @default(1)
  assignmentTimeoutMinutes         Int              @default(5)
  participationConfirmationMinutes Int              @default(0)
  mapAssignmentCap                 Int?
  scoringMode                      EventScoringMode @default(SIMPLE)
  scoringRules                     Json?
  rulebookMarkdown                 String?

  guild    Guild          @relation(fields: [guildId], references: [id])
  heroNpcs EventHeroNpc[]
  rankings EventRanking[]

  @@index([guildId, startsAt, endsAt])
  @@index([world])
}

model EventMapLocation {
  id        String   @id @default(cuid())
  heroNpcId String
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  heroNpc EventHeroNpc @relation(fields: [heroNpcId], references: [id], onDelete: Cascade)
  maps    EventMap[]

  @@unique([heroNpcId, name])
  @@index([heroNpcId, order])
}

model EventMap {
  id         String   @id @default(cuid())
  heroNpcId  String
  locationId String?
  mapId      Int
  mapName    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  heroNpc           EventHeroNpc                @relation(fields: [heroNpcId], references: [id], onDelete: Cascade)
  location          EventMapLocation?           @relation(fields: [locationId], references: [id], onDelete: SetNull)
  assignedMembers   Member[]
  presenceLogs      EventPresenceLog[]
  coverageGaps      EventMapCoverageGap[]
  assignmentHistory EventMapAssignmentHistory[]

  @@unique([heroNpcId, mapId])
  @@index([mapId])
  @@index([mapName])
  @@index([locationId])
}

enum CoverageGapType {
  UNASSIGNED // No member is assigned to the map
  UNCOVERED  // Members assigned but no one is present on the map
}

enum EventScoringMode {
  SIMPLE
  ADVANCED
}

model EventMapCoverageGap {
  id                 String          @id @default(cuid())
  mapId              String
  heroNpcId          String
  gapType            CoverageGapType
  startedAt          DateTime
  endedAt            DateTime?
  durationSeconds    Int?
  hadAssignedMembers Boolean?

  map     EventMap     @relation(fields: [mapId], references: [id], onDelete: Cascade)
  heroNpc EventHeroNpc @relation(fields: [heroNpcId], references: [id], onDelete: Cascade)

  @@index([mapId, gapType, endedAt])
  @@index([heroNpcId, endedAt])
  @@index([heroNpcId, startedAt])
  @@index([mapId, startedAt])
}

model EventMapAssignmentHistory {
  id           String    @id @default(cuid())
  mapId        String
  heroNpcId    String
  memberId     Int
  assignedAt   DateTime  @default(now())
  unassignedAt DateTime?

  map     EventMap     @relation(fields: [mapId], references: [id], onDelete: Cascade)
  heroNpc EventHeroNpc @relation(fields: [heroNpcId], references: [id], onDelete: Cascade)
  member  Member       @relation(fields: [memberId], references: [id])

  @@index([mapId, assignedAt])
  @@index([heroNpcId, assignedAt])
  @@index([memberId])
}

model EventHeroNpc {
  id        String   @id @default(cuid())
  eventId   String
  npcId     Int?
  npcName   String
  npcIcon   String?
  npcLvl    Int?
  createdAt DateTime @default(now())

  event             Event                       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  kills             EventHeroKill[]
  maps              EventMap[]
  locations         EventMapLocation[]
  coverageGaps      EventMapCoverageGap[]
  assignmentHistory EventMapAssignmentHistory[]
  windowSummaries   EventRespawnWindowSummary[]

  @@unique([eventId, npcName])
  @@index([npcId])
}

model EventPresenceLog {
  id        String    @id @default(cuid())
  mapId     String
  memberId  Int
  isAfk     Boolean
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  map    EventMap @relation(fields: [mapId], references: [id], onDelete: Cascade)
  member Member   @relation(fields: [memberId], references: [id])

  @@index([mapId, memberId])
  @@index([mapId, endedAt, isAfk, memberId])
  @@index([startedAt, endedAt])
}

model EventHeroKill {
  id                 String   @id @default(cuid())
  heroNpcId          String
  killedAt           DateTime @default(now())
  minSpawnTimeAtKill DateTime
  maxSpawnTimeAtKill DateTime
  timerCreatedById   Int?
  isManualClose      Boolean  @default(false)

  heroNpc        EventHeroNpc               @relation(fields: [heroNpcId], references: [id], onDelete: Cascade)
  timerCreatedBy Member?                    @relation("KillDetectedBy", fields: [timerCreatedById], references: [id])
  points         EventKillPoint[]
  windowSummary  EventRespawnWindowSummary?

  @@index([heroNpcId])
  @@index([heroNpcId, killedAt])
  @@index([killedAt])
}

model EventKillPoint {
  id                      String   @id @default(cuid())
  killId                  String
  memberId                Int
  basePoints              Float
  points                  Float
  manualAdjustmentPoints  Float    @default(0)
  trackingDurationSeconds     Int?
  trackingDurationPercentage  Float?
  confirmationDeadlineAt      DateTime?
  confirmedAt                 DateTime?
  timeOnMapSeconds        Int
  afkPercentage           Float
  wasPresent              Boolean
  bonusBreakdown          Json?
  mapPresenceData         Json?
  createdAt               DateTime @default(now())

  kill   EventHeroKill @relation(fields: [killId], references: [id], onDelete: Cascade)
  member Member        @relation(fields: [memberId], references: [id])

  @@unique([killId, memberId])
  @@index([memberId])
  @@index([memberId, confirmationDeadlineAt, confirmedAt])
}

model EventRanking {
  id                     String   @id @default(cuid())
  eventId                String
  memberId               Int
  heroNpcName            String
  totalPoints            Float    @default(0)
  manualAdjustmentPoints Float @default(0)
  totalKills             Int      @default(0)
  totalTimeSeconds       Int      @default(0)
  avgAfkPercentage       Float    @default(0)
  pointsModified         Boolean  @default(false)
  updatedAt              DateTime @updatedAt

  event       Event                     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member      Member                    @relation(fields: [memberId], references: [id])
  editHistory EventPointsEditHistory[]

  @@unique([eventId, memberId, heroNpcName])
  @@index([eventId, totalPoints(sort: Desc)])
}

enum PointsEditType {
  KILL_POINT
  RANKING
}

model EventPointsEditHistory {
  id             String         @id @default(cuid())
  rankingId      String
  previousPoints Float
  newPoints      Float
  editType       PointsEditType
  editedByUserId String
  comment        String?
  editedAt       DateTime       @default(now())

  ranking EventRanking @relation(fields: [rankingId], references: [id], onDelete: Cascade)

  @@index([rankingId, editedAt(sort: Desc)])
}

model EventRespawnWindowSummary {
  id        String  @id @default(cuid())
  heroNpcId String
  killId    String? @unique

  windowOpenedAt DateTime
  windowClosedAt DateTime
  minSpawnTime   DateTime
  maxSpawnTime   DateTime
  wasManualClose Boolean @default(false)

  totalWindowSeconds     Int
  totalCoverageSeconds   Int
  totalUncoveredSeconds  Int
  totalUnassignedSeconds Int
  coveragePercentage     Float

  memberStats  Json
  mapStats     Json
  gapsTimeline Json

  createdAt DateTime @default(now())

  heroNpc EventHeroNpc   @relation(fields: [heroNpcId], references: [id], onDelete: Cascade)
  kill    EventHeroKill? @relation(fields: [killId], references: [id], onDelete: SetNull)

  @@index([heroNpcId])
  @@index([windowClosedAt])
}

model MapTemplate {
  id        String   @id @default(cuid())
  guildId   String
  name      String
  maps      Json
  createdAt DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id])

  @@unique([guildId, name])
  @@index([guildId])
}

model GuildDocument {
  id                String    @id @default(cuid())
  guildId           String
  title             String
  content           Json
  version           Int       @default(1)
  createdByMemberId String
  updatedByMemberId String
  deletedAt         DateTime?
  deletedByMemberId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  guild   Guild                  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  history GuildDocumentHistory[]

  @@index([guildId, deletedAt, updatedAt(sort: Desc)])
  @@index([guildId, deletedAt(sort: Desc)])
}

model GuildDocumentHistory {
  id            String                     @id @default(cuid())
  documentId    String
  guildId       String
  version       Int
  title         String
  content       Json
  action        GuildDocumentHistoryAction @default(SAVE)
  actorMemberId String
  editedAt      DateTime                   @default(now())

  document GuildDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  guild    Guild         @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([documentId, version])
  @@index([documentId, editedAt(sort: Desc)])
  @@index([guildId, editedAt(sort: Desc)])
}

// Kill tracking - aggregated stats per NPC per member (guild-specific)
model NpcKillStats {
  id           String   @id @default(cuid())
  guildId      String
  memberId     Int
  userId       String
  world        String
  npcId        Int
  npcName      String
  npcType      NpcType
  npcLvl       Int
  npcProf      String?
  npcIcon      String?
  memberKills  Int      @default(0)
  lastKilledAt DateTime @default(now())
  updatedAt    DateTime @updatedAt

  guild  Guild  @relation(fields: [guildId], references: [id])
  member Member @relation(fields: [memberId], references: [id])

  @@unique([guildId, memberId, world, npcId])
  @@index([guildId])
  @@index([guildId, npcType])
  @@index([guildId, world, npcType])
  @@index([memberId])
}

// Kill tracking - personal stats per NPC per user (no guild requirement)
model UserKillStats {
  id           String   @id @default(cuid())
  userId       String
  world        String
  npcId        Int
  npcName      String
  npcType      NpcType
  npcLvl       Int
  npcProf      String?
  npcIcon      String?
  totalKills   Int      @default(0)
  lastKilledAt DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, world, npcId])
  @@index([userId])
  @@index([userId, npcType])
  @@index([userId, world, npcType])
}

// Kill tracking - aggregated unique kills per NPC per guild (deduplicated)
model GuildKillSummary {
  id           String   @id @default(cuid())
  guildId      String
  world        String
  npcId        Int
  npcName      String
  npcType      NpcType
  npcLvl       Int
  npcProf      String?
  npcIcon      String?
  uniqueKills  Int      @default(0)
  lastKilledAt DateTime @default(now())
  updatedAt    DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id])

  @@unique([guildId, world, npcId])
  @@index([guildId])
  @@index([guildId, npcType])
  @@index([guildId, world, npcType])
}

// Kill tracking - hourly personal stats per NPC per user
model UserKillStatsBucket {
  id           String   @id @default(cuid())
  userId       String
  world        String
  npcId        Int
  npcName      String
  npcType      NpcType
  npcLvl       Int
  npcProf      String?
  npcIcon      String?
  totalKills   Int      @default(0)
  periodStart  DateTime
  lastKilledAt DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, world, npcId, periodStart])
  @@index([userId, periodStart])
  @@index([userId, npcType, periodStart])
  @@index([userId, world, npcType, periodStart])
}

// Kill tracking - hourly aggregated stats per NPC per member
model NpcKillStatsBucket {
  id           String   @id @default(cuid())
  guildId      String
  memberId     Int
  userId       String
  world        String
  npcId        Int
  npcName      String
  npcType      NpcType
  npcLvl       Int
  npcProf      String?
  npcIcon      String?
  memberKills  Int      @default(0)
  periodStart  DateTime
  lastKilledAt DateTime @default(now())
  updatedAt    DateTime @updatedAt

  guild  Guild  @relation(fields: [guildId], references: [id])
  member Member @relation(fields: [memberId], references: [id])

  @@unique([guildId, memberId, world, npcId, periodStart])
  @@index([guildId, periodStart])
  @@index([guildId, npcType, periodStart])
  @@index([guildId, world, npcType, periodStart])
  @@index([memberId, periodStart])
}

// Kill tracking - hourly aggregated unique kills per NPC per guild
model GuildKillSummaryBucket {
  id           String   @id @default(cuid())
  guildId      String
  world        String
  npcId        Int
  npcName      String
  npcType      NpcType
  npcLvl       Int
  npcProf      String?
  npcIcon      String?
  uniqueKills  Int      @default(0)
  periodStart  DateTime
  lastKilledAt DateTime @default(now())
  updatedAt    DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id])

  @@unique([guildId, world, npcId, periodStart])
  @@index([guildId, periodStart])
  @@index([guildId, npcType, periodStart])
  @@index([guildId, world, npcType, periodStart])
}
