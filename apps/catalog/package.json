{
  "name": "@lootlog/catalog",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "build": "bun build src/main.ts --target=bun --packages=external --outdir=dist/src --sourcemap=linked",
    "start": "bun dist/src/main.js",
    "lint": "oxlint src test",
    "typecheck": "bun check",
    "test": "bun test --path-ignore-patterns='**/*.integration.*'",
    "test:integration": "bun test test/catalog-writes.integration.test.ts",
    "openapi:generate": "bun --conditions=development src/openapi/generate-openapi.ts",
    "projection:rebuild": "bun src/scripts/rebuild-projection.ts",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate:dev": "bun src/database/migrate.ts",
    "db:migrate:deploy": "bun src/database/migrate.ts",
    "db:studio": "bunx drizzle-kit studio"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@lootlog/database": "workspace:*",
    "@lootlog/domain": "workspace:*",
    "@lootlog/instrumentation": "workspace:*",
    "@lootlog/meilisearch": "workspace:*",
    "@lootlog/messaging": "workspace:*",
    "@lootlog/protocol": "workspace:*",
    "@lootlog/schema": "workspace:*",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "es-toolkit": "catalog:",
    "meilisearch": "^0.62.0"
  },
  "devDependencies": {
    "@lootlog/typescript-config": "workspace:*",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "catalog:",
    "pg": "^8.23.1",
    "typescript": "catalog:",
    "yaml": "catalog:"
  }
}
