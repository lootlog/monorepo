# Service Configuration
PORT=4006
ENV=local
SERVICE_NAME=catalog

# The catalog's own database
POSTGRESQL_CONNECTION_URI=postgresql://user:password@localhost:5436/catalog

# Meilisearch
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=meilisearch_master_key

# RabbitMQ Message Queue
RABBITMQ_URI=amqp://rabbitmq_user:rabbitmq_password@localhost:5672

# What trusted services (the wiki's Worker, the Discord bot) present to read.
# Required outside ENV=local; at least 32 characters.
CATALOG_SERVICE_TOKEN=

# OpenTelemetry Configuration
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_EXPORTER=otlp
SERVICE_NAMESPACE=local
