{
  "extends": "@lootlog/typescript-config/base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "~/*": ["./src/*"]
    },
    "noEmit": true
  },
  "include": ["src", "content-collections.ts", "vite.config.ts"],
  "exclude": ["node_modules", ".output"]
}
