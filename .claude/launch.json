{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "game-client-sandbox",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "--cwd",
        "apps/game-client",
        "dev:sandbox"
      ],
      "port": 3010
    },
    {
      "name": "wiki-worktree",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "apps/wiki/node_modules/.bin/vite",
        "dev",
        "apps/wiki",
        "--config",
        "apps/wiki/vite.worktree.mts"
      ],
      "port": 3106,
      "autoPort": false
    }
  ]
}
