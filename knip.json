{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "workspaces": {
    ".": {
      "entry": [],
      "project": [],
      "ignoreDependencies": ["wrangler"]
    },
    "apps/*": {
      "entry": [
        "src/index.ts",
        "src/main.ts",
        "src/main.tsx",
        "src/App.tsx",
        "src/openapi/generate-openapi.ts",
        "scripts/**/*.{ts,mjs}",
        "server.js",
        "src/**/*.test.{ts,tsx}",
        "vite.worktree.mts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "test/**/*.{ts,tsx}",
        "lib/**/*.{ts,tsx}",
        "components/**/*.{ts,tsx}",
        "scripts/**/*.{ts,mjs}",
        "*.{ts,mts,js,mjs}",
        "*.config.{ts,mts,js,mjs}",
        "**/*.{spec,test,e2e-spec}.{ts,tsx,js}"
      ]
    },
    "apps/game-client": {
      "entry": [
        "src/main.tsx",
        "sandbox/main.ts",
        "extension/entrypoints/**/*.ts",
        "vite.config.ts",
        "src/shims/use-sync-external-store-with-selector.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "sandbox/**/*.{ts,tsx}",
        "*.{ts,mts,js,mjs}",
        "*.config.{ts,mts,js,mjs}",
        "**/*.{spec,test,e2e-spec}.{ts,tsx,js}",
        "extension/**/*.{ts,tsx}"
      ],
      "vite": false,
      "ignoreDependencies": ["shadcn"]
    },
    "packages/*": {
      "project": [
        "src/**/*.{ts,tsx}",
        "scripts/**/*.{ts,mjs}",
        "*.{ts,mts,js,mjs}",
        "*.config.{ts,mts,js,mjs}",
        "**/*.{spec,test}.{ts,tsx,js}"
      ],
      "includeEntryExports": true
    },
    "packages/ui": {
      "project": [
        "src/**/*.{ts,tsx}",
        "*.{ts,mts,js,mjs}",
        "**/*.{spec,test}.{ts,tsx,js}"
      ],
      "includeEntryExports": true,
      "ignore": [
        "src/components/{accordion,alert-dialog,alert,avatar,badge,breadcrumb,button,calendar,card,chart,checkbox,collapsible,combobox,command,context-menu,dialog,drawer,dropdown-menu,empty,field,form,input-group,input,kbd,label,popover,progress,radio-group,scroll-area,select,separator,sheet,sidebar,skeleton,slider,sonner,spinner,switch,table,tabs,textarea,toggle-group,tooltip}.tsx"
      ]
    },
    "packages/game-client-api": {},
    "packages/client": {
      "entry": ["src/generated/**/*.{ts,tsx}", "scripts/**/*.{ts,mjs}"],
      "project": [
        "src/**/*.{ts,tsx}",
        "scripts/**/*.{ts,mjs}",
        "*.{ts,mts,js,mjs}",
        "*.config.{ts,mts,js,mjs}",
        "**/*.{spec,test}.{ts,tsx,js}"
      ]
    },
    "packages/sdk": {
      "entry": [
        "src/index.ts",
        "src/generated/**/*.{ts,tsx}",
        "scripts/**/*.{ts,mjs}"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "scripts/**/*.{ts,mjs}",
        "*.{ts,mts,js,mjs}",
        "*.config.{ts,mts,js,mjs}",
        "**/*.{spec,test}.{ts,tsx,js}"
      ],
      "ignoreDependencies": ["@lootlog/protocol"]
    }
  },
  "ignoreWorkspaces": ["repos/**"],
  "ignoreDependencies": [
    "@effect/language-service",
    "@fontsource-variable/geist",
    "@fontsource-variable/geist-mono",
    "@tailwindcss/postcss",
    "@types/mdx",
    "husky",
    "tailwindcss",
    "tw-animate-css"
  ],
  "ignoreBinaries": ["check", "jq"],
  "vite": true,
  "vitest": true
}
