{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "workspaces": {
    ".": {
      "entry": ["tools/**/*.{js,mjs}"],
      "project": ["tools/**/*.{js,mjs}"],
      "ignoreDependencies": ["k6", "zod"]
    },
    "apps/*": {
      "entry": [
        "src/index.ts",
        "src/main.ts",
        "src/main.tsx",
        "src/app.tsx",
        "src/App.tsx",
        "src/instrumentation.ts",
        "src/openapi/generate-openapi.ts",
        "src/generated/**/*.{ts,tsx}",
        "scripts/**/*.{ts,mjs}",
        "server.js"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "test/**/*.{ts,tsx}",
        "scripts/**/*.{ts,mjs}",
        "*.{ts,mts,js,mjs}",
        "*.config.{ts,mts,js,mjs}",
        "**/*.{spec,test,e2e-spec}.{ts,tsx,js}"
      ]
    },
    "apps/game-client": {
      "entry": ["src/main.tsx", "scripts/**/*.{ts,mjs}"],
      "project": [
        "src/**/*.{ts,tsx}",
        "test/**/*.{ts,tsx}",
        "scripts/**/*.{ts,mjs}",
        "*.{ts,mts,js,mjs}",
        "*.config.{ts,mts,js,mjs}",
        "**/*.{spec,test,e2e-spec}.{ts,tsx,js}"
      ],
      "vite": false
    },
    "packages/*": {
      "entry": [
        "src/index.ts",
        "index.ts",
        "src/generated/**/*.{ts,tsx}",
        "scripts/**/*.{ts,mjs}"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "scripts/**/*.{ts,mjs}",
        "*.{ts,mts,js,mjs}",
        "*.config.{ts,mts,js,mjs}",
        "**/*.{spec,test}.{ts,tsx,js}"
      ]
    }
  },
  "ignore": ["**/dist/**", "**/build/**", "**/node_modules/**"],
  "ignoreWorkspaces": ["repos/**"],
  "ignoreDependencies": [
    "@fontsource-variable/geist",
    "@fontsource-variable/geist-mono",
    "@lootlog/ui",
    "@tailwindcss/postcss",
    "@types/mdx",
    "husky",
    "tailwindcss",
    "tw-animate-css"
  ],
  "ignoreBinaries": ["k6"],
  "vite": true,
  "vitest": true
}
