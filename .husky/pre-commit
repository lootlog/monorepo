#!/bin/sh
set -e

echo "🚀 Running pre-commit checks..."

echo "\n📝 Formatting staged files..."
bunx lint-staged

echo "\n🔍 Linting changed packages..."
bunx turbo run lint --filter=[HEAD]

echo "\n🎨 Checking code formatting..."
bun run format:check

echo "\n🧪 Running tests for changed packages..."
bunx turbo run test --filter=[HEAD]

echo "\n✅ All pre-commit checks passed!"
