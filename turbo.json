{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "lint": {
      "dependsOn": ["transit"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**/*.ts",
        "src/**/*.tsx",
        "**/*.ts",
        "**/*.tsx",
        ".oxlintrc.json",
        "$TURBO_ROOT$/.oxlintrc.json"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build", "transit"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**/*.ts",
        "src/**/*.tsx",
        "**/*.ts",
        "**/*.tsx",
        "tsconfig.json"
      ]
    },
    "doctor": {
      "cache": false,
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "preview": {
      "cache": false,
      "persistent": true
    },
    "openapi:generate": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": ["openapi.yaml"]
    },
    "client:generate": {
      "dependsOn": [
        "@lootlog/activity#openapi:generate",
        "@lootlog/api#openapi:generate",
        "@lootlog/auth#openapi:generate",
        "@lootlog/battlelog#openapi:generate",
        "@lootlog/search#openapi:generate"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/activity/openapi.yaml",
        "$TURBO_ROOT$/apps/api/openapi.yaml",
        "$TURBO_ROOT$/apps/auth/openapi.yaml",
        "$TURBO_ROOT$/apps/battlelog/openapi.yaml",
        "$TURBO_ROOT$/apps/search/openapi.yaml"
      ],
      "outputs": ["src/generated/**"]
    },
    "client:check": {
      "cache": false,
      "dependsOn": ["client:generate"],
      "outputs": []
    },
    "env:generate": {
      "cache": false,
      "interactive": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**/*.ts",
        "src/**/*.tsx",
        "test/**/*.ts",
        "**/*.spec.ts",
        "vitest.config.*",
        "tsconfig.json"
      ]
    },
    "test:integration": {
      "cache": false,
      "dependsOn": ["^build"],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**/*.ts",
        "test/**/*.ts",
        "test/**/*.e2e-spec.ts",
        "vitest.config.*",
        "vitest.config.e2e.*",
        "tsconfig.json"
      ]
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate:dev": {
      "cache": false,
      "interactive": true
    },
    "db:migrate:deploy": {
      "cache": false
    },
    "db:migrate:init": {
      "cache": false
    },
    "auth:migrate:plan": {
      "cache": false
    },
    "auth:migrate:apply": {
      "cache": false
    },
    "db:pull": {
      "cache": false,
      "interactive": true
    },
    "db:push": {
      "cache": false,
      "interactive": true
    },
    "db:studio": {
      "cache": false,
      "interactive": true,
      "persistent": true
    },
    "events": {
      "cache": false,
      "interactive": true
    },
    "events:publish": {
      "cache": false,
      "interactive": true
    },
    "seed": {
      "cache": false,
      "interactive": true
    },
    "seed:generate:players": {
      "cache": false,
      "interactive": true
    },
    "seed:scrape": {
      "cache": false,
      "interactive": true
    },
    "seed:scrape:items": {
      "cache": false,
      "interactive": true
    },
    "seed:scrape:npcs": {
      "cache": false,
      "interactive": true
    },
    "seed:setup": {
      "cache": false,
      "interactive": true
    },
    "maintenance:audit-actions": {
      "cache": false
    },
    "maintenance:backfill-warrior-stats": {
      "cache": false
    },
    "deploy": {
      "dependsOn": ["build"],
      "cache": false
    },
    "deploy:develop": {
      "dependsOn": ["build"],
      "cache": false
    },
    "deploy:version": {
      "dependsOn": ["build"],
      "cache": false
    },
    "deploy:version:develop": {
      "dependsOn": ["build"],
      "cache": false
    }
  }
}
