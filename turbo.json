{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "RABBITMQ_URI",
    "ENV",
    "PORT",
    "HOSTNAME",
    "AXIOM_DATASET",
    "AXIOM_TOKEN",
    "REDIS_HOST",
    "REDIS_PASSWORD",
    "REDIS_PORT",
    "REDIS_USERNAME"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["GAME_CLIENT_URL"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        "out/**",
        "generated/**"
      ]
    },
    "build:game-client": {},
    "copy-entrypoint": {},
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": [],
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "**/*.ts",
        "**/*.tsx",
        ".eslintrc*",
        "eslint.config.*"
      ]
    },
    "check-types": {
      "dependsOn": ["^check-types"],
      "outputs": [],
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "**/*.ts",
        "**/*.tsx",
        "tsconfig.json"
      ]
    },
    "dev": {
      "dependsOn": [],
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["^start"]
    },
    "api:migrate:dev": {
      "cache": false,
      "interactive": true
    },
    "api:generate": {
      "cache": false
    },
    "api:studio": {
      "cache": false,
      "interactive": false
    },
    "auth:migrate:dev": {
      "cache": false,
      "interactive": true
    },
    "auth:migrate:prod": {
      "cache": false,
      "interactive": false
    },
    "env:generate": {
      "cache": false,
      "interactive": true
    },
    "test": {
      "dependsOn": ["^test", "api:generate", "battlelog:generate"],
      "outputs": [],
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "test/**/*.ts",
        "**/*.spec.ts",
        "jest.config.*",
        "vitest.config.*",
        "tsconfig.json"
      ]
    },
    "battlelog:migrate:dev": {
      "cache": false,
      "interactive": true
    },
    "battlelog:generate": {
      "cache": false
    },
    "battlelog:studio": {
      "cache": false,
      "interactive": false
    }
  }
}
