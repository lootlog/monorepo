{
  "name": "@lootlog/app",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack microservices application for Margonem clan loot tracking, battle logging, and Discord bot integration",
  "keywords": [
    "battle-logging",
    "clan-management",
    "discord-bot",
    "effect",
    "lootlog",
    "margonem",
    "microservices",
    "react",
    "turborepo",
    "typescript"
  ],
  "homepage": "https://lootlog.pl",
  "bugs": {
    "url": "https://github.com/lootlog/monorepo/issues"
  },
  "license": "MIT",
  "author": "Kamil <kamilwronka7@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/lootlog/monorepo.git"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@effect/platform-bun": "4.0.0-rc.112",
      "@effect/sql-pg": "4.0.0-rc.112",
      "@lexical/code": "0.48.0",
      "@lexical/link": "0.48.0",
      "@lexical/list": "0.48.0",
      "@lexical/markdown": "0.48.0",
      "@lexical/react": "0.48.0",
      "@lexical/rich-text": "0.48.0",
      "@lexical/selection": "0.48.0",
      "@lexical/table": "0.48.0",
      "@lexical/utils": "0.48.0",
      "@hookform/resolvers": "^5.9.1",
      "@tailwindcss/postcss": "^4.3.3",
      "@tailwindcss/vite": "^4.3.3",
      "@tanstack/react-query": "^5.102.8",
      "@tanstack/react-query-devtools": "^5.102.8",
      "@tanstack/react-router": "^1.170.32",
      "@types/node": "^26.4.0",
      "@types/bun": "1.4.0",
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.5",
      "@vitejs/plugin-react": "^6.1.1",
      "drizzle-kit": "1.0.0-rc.4",
      "drizzle-orm": "1.0.0-rc.4",
      "effect": "4.0.0-rc.112",
      "lexical": "0.48.0",
      "postcss-load-config": "^6.0.1",
      "react": "^19.2.8",
      "react-doctor": "0.9.12",
      "react-dom": "^19.2.8",
      "react-hook-form": "7.86.0",
      "superjson": "^2.2.2",
      "tailwindcss": "^4.3.3",
      "typescript": "^7.0.2",
      "vite": "^8.2.2",
      "vitest": "^4.1.11",
      "yaml": "2.9.0",
      "zod": "^4.4.3"
    }
  },
  "scripts": {
    "dev": "turbo run dev --concurrency 16",
    "dev:core": "turbo run dev --filter=@lootlog/api --filter=@lootlog/auth --filter=@lootlog/gateway --filter=@lootlog/web --filter=@lootlog/game-client --filter=@lootlog/search --filter=@lootlog/discord-bot --concurrency 13",
    "dev:wiki": "turbo run dev --filter=@lootlog/wiki --filter=@lootlog/search --filter=@lootlog/auth",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "doctor": "turbo run doctor",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "deps:check": "POSTGRESQL_CONNECTION_URI=postgresql://knip:knip@127.0.0.1:1/knip knip --dependencies --no-config-hints",
    "architecture:effect": "bun tools/check-effect-architecture.ts",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "perf:gateway": "bun tools/k6/gateway.mjs",
    "perf:k6": "bun tools/k6/run-k6.mjs",
    "perf:k6:smoke": "bun tools/k6/run-k6.mjs --profile smoke",
    "openapi:generate": "turbo run openapi:generate --filter=@lootlog/api --filter=@lootlog/search --filter=@lootlog/activity --filter=@lootlog/battlelog --filter=@lootlog/auth --filter=@lootlog/gateway --filter=@lootlog/discord-bot",
    "openapi:parity": "bun packages/client/scripts/check-openapi-parity.ts",
    "client:check": "turbo run client:check --filter=@lootlog/client",
    "client:generate": "turbo run client:generate --filter=@lootlog/client",
    "db:activity:generate": "turbo run db:generate --filter=@lootlog/activity",
    "db:activity:migrate:dev": "turbo run db:migrate:dev --filter=@lootlog/activity",
    "db:activity:migrate:deploy": "turbo run db:migrate:deploy --filter=@lootlog/activity",
    "db:activity:studio": "turbo run db:studio --filter=@lootlog/activity",
    "db:api:generate": "turbo run db:generate --filter=@lootlog/api",
    "db:api:migrate:dev": "turbo run db:migrate:dev --filter=@lootlog/api --ui=tui",
    "db:api:migrate:deploy": "turbo run db:migrate:deploy --filter=@lootlog/api",
    "db:api:studio": "turbo run db:studio --filter=@lootlog/api",
    "db:auth:generate": "turbo run db:generate --filter=@lootlog/auth",
    "db:auth:migrate:plan": "turbo run auth:migrate:plan --filter=@lootlog/auth",
    "db:auth:migrate:apply": "turbo run auth:migrate:apply --filter=@lootlog/auth",
    "db:auth:migrate:dev": "turbo run db:migrate:dev --filter=@lootlog/auth",
    "db:auth:migrate:deploy": "turbo run db:migrate:deploy --filter=@lootlog/auth",
    "db:auth:migrate:init": "turbo run db:migrate:init --filter=@lootlog/auth",
    "db:auth:studio": "turbo run db:studio --filter=@lootlog/auth",
    "db:battlelog:generate": "turbo run db:generate --filter=@lootlog/battlelog",
    "db:battlelog:migrate:deploy": "turbo run db:migrate:deploy --filter=@lootlog/battlelog",
    "db:battlelog:migrate:init": "turbo run db:migrate:init --filter=@lootlog/battlelog",
    "db:battlelog:pull": "turbo run db:pull --filter=@lootlog/battlelog",
    "db:battlelog:push": "turbo run db:push --filter=@lootlog/battlelog",
    "db:battlelog:studio": "turbo run db:studio --filter=@lootlog/battlelog",
    "env:generate": "turbo run env:generate",
    "events": "turbo run events --filter=@lootlog/cli",
    "events:publish": "turbo run events:publish --filter=@lootlog/cli",
    "seed": "turbo run seed --filter=@lootlog/cli",
    "seed:generate:players": "turbo run seed:generate:players --filter=@lootlog/cli",
    "seed:scrape": "turbo run seed:scrape --filter=@lootlog/cli",
    "seed:scrape:items": "turbo run seed:scrape:items --filter=@lootlog/cli",
    "seed:scrape:npcs": "turbo run seed:scrape:npcs --filter=@lootlog/cli",
    "seed:setup": "turbo run seed:setup --filter=@lootlog/cli",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "prepare": "bun -e 'if (process.env.NODE_ENV !== \"production\" && process.env.HUSKY !== \"0\") { const { default: husky } = await import(\"husky\"); const message = husky(); if (message.length > 0) console.log(message); }'"
  },
  "devDependencies": {
    "@babel/parser": "7.29.8",
    "@changesets/cli": "^3.0.1",
    "@lootlog/client": "workspace:*",
    "husky": "^9.1.7",
    "jsonc-parser": "^3.3.1",
    "knip": "^6.32.3",
    "lint-staged": "^17.4.1",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.80.0",
    "react-doctor": "catalog:",
    "turbo": "2.10.12",
    "typescript": "catalog:",
    "wrangler": "^4.127.0"
  },
  "overrides": {
    "deepmerge-ts@<=7.1.5": ">=8.0.2",
    "esbuild@<=0.25.12": ">=0.28.2",
    "find-my-way@<=9.6.0": ">=9.7.0",
    "js-yaml@>=5.0.0 <=5.2.1": ">=5.2.2",
    "postcss@<8.5.10": ">=8.5.10",
    "postcss@<=8.5.11": ">=8.5.12",
    "postcss@<=8.5.17": ">=8.5.18",
    "sharp@<0.35.0": ">=0.35.0",
    "typescript": "catalog:",
    "valibot@<=1.4.1": ">=1.4.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0",
      "onFail": "ignore"
    }
  },
  "engines": {
    "bun": "1.4.0"
  },
  "packageManager": "bun@1.4.0",
  "patchedDependencies": {
    "drizzle-orm@1.0.0-rc.4": "patches/drizzle-orm@1.0.0-rc.4.patch"
  },
  "trustedDependencies": [
    "@scarf/scarf",
    "@tailwindcss/oxide",
    "core-js-pure",
    "cpu-features",
    "esbuild",
    "msgpackr-extract",
    "protobufjs",
    "rolldown",
    "sharp",
    "ssh2",
    "unrs-resolver",
    "workerd"
  ]
}
