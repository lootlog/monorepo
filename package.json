{
  "name": "@lootlog/app",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack microservices application for Margonem clan loot tracking, battle logging, and Discord bot integration",
  "keywords": [
    "battle-logging",
    "clan-management",
    "discord-bot",
    "lootlog",
    "margonem",
    "microservices",
    "nestjs",
    "react",
    "turborepo",
    "typescript"
  ],
  "homepage": "https://lootlog.pl",
  "bugs": {
    "url": "https://github.com/lootlog/lootlog/issues"
  },
  "license": "MIT",
  "author": "Kamil <kamilwronka7@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/lootlog/lootlog.git"
  },
  "scripts": {
    "dev": "turbo run dev --concurrency 15",
    "dev:core": "turbo run dev --filter=@lootlog/api --filter=@lootlog/auth --filter=@lootlog/gateway --filter=@lootlog/web --filter=@lootlog/game-client --filter=@lootlog/search --filter=@lootlog/discord-bot --concurrency 13",
    "dev:wiki": "turbo run dev --filter=@lootlog/wiki --filter=@lootlog/search --filter=@lootlog/auth",
    "build": "turbo run build",
    "start": "turbo run start",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "doctor": "turbo run doctor",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "perf:gateway": "node tools/k6/gateway.mjs",
    "perf:k6": "node tools/k6/run-k6.mjs",
    "perf:k6:service": "node tools/k6/run-k6.mjs",
    "perf:k6:smoke": "node tools/k6/run-k6.mjs --profile smoke",
    "openapi:generate": "turbo run openapi:generate --filter=@lootlog/api --filter=@lootlog/search --filter=@lootlog/activity --filter=@lootlog/battlelog-service --filter=@lootlog/auth",
    "activity:generate": "turbo run activity:generate",
    "activity:migrate:dev": "turbo run activity:migrate:dev",
    "activity:studio": "turbo run activity:studio",
    "api-client:check": "turbo run api-client:check --filter=@lootlog/api-client",
    "api-client:generate": "turbo run api-client:generate --filter=@lootlog/api-client",
    "api:generate": "turbo run api:generate",
    "api:migrate:dev": "turbo run api:migrate:dev --filter=@lootlog/api --ui=tui",
    "api:studio": "turbo run api:studio",
    "auth:migrate:dev": "turbo run auth:migrate:dev --filter=@lootlog/auth",
    "auth:migrate:prod": "turbo run auth:migrate:prod --filter=@lootlog/auth",
    "battlelog:generate": "turbo run battlelog:generate",
    "battlelog:migrate": "turbo run battlelog:migrate",
    "battlelog:migrate:dev": "turbo run battlelog:migrate:dev",
    "battlelog:migrate:init": "turbo run battlelog:migrate:init",
    "battlelog:studio": "turbo run battlelog:studio",
    "env:generate": "turbo run env:generate",
    "events": "tsx packages/cli/src/index.ts events",
    "events:publish": "tsx packages/cli/src/index.ts events publish",
    "seed": "tsx packages/cli/src/index.ts seed",
    "seed:generate:players": "tsx packages/cli/src/index.ts seed generate:players",
    "seed:scrape": "tsx packages/cli/src/index.ts seed scrape:all",
    "seed:scrape:items": "tsx packages/cli/src/index.ts seed scrape:items",
    "seed:scrape:npcs": "tsx packages/cli/src/index.ts seed scrape:npcs",
    "seed:setup": "tsx packages/cli/src/index.ts seed setup",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@lootlog/socket-parser": "workspace:*",
    "@lootlog/typescript-config": "workspace:*",
    "husky": "^9.1.7",
    "knip": "^6.30.0",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "socket.io-client": "^4.8.3",
    "tsx": "catalog:",
    "turbo": "^2.10.7",
    "typescript": "catalog:",
    "wrangler": "^4.116.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.17.0",
      "onFail": "ignore"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.17.0"
}
