{
  "name": "@lootlog/app",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack microservices application for Margonem clan loot tracking, battle logging, and Discord bot integration",
  "keywords": [
    "battle-logging",
    "clan-management",
    "discord-bot",
    "lootlog",
    "margonem",
    "microservices",
    "nestjs",
    "react",
    "turborepo",
    "typescript"
  ],
  "homepage": "https://lootlog.pl",
  "bugs": {
    "url": "https://github.com/lootlog/lootlog/issues"
  },
  "license": "MIT",
  "author": "Kamil <kamilwronka7@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/lootlog/lootlog.git"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --concurrency 14",
    "dev:core": "turbo dev --filter=@lootlog/api --filter=@lootlog/auth --filter=@lootlog/gateway --filter=@lootlog/web --filter=@lootlog/game-client --filter=@lootlog/search --filter=@lootlog/discord-bot --concurrency 13",
    "dev:wiki": "turbo dev --filter=@lootlog/wiki --filter=@lootlog/search --filter=@lootlog/auth",
    "start": "turbo start",
    "lint": "turbo lint",
    "doctor": "turbo run doctor",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",
    "openapi:generate": "turbo run openapi:generate --filter=@lootlog/api --filter=@lootlog/search --filter=@lootlog/activity --filter=@lootlog/battlelog-service --filter=@lootlog/auth",
    "openapi:check": "tsx ./scripts/check-openapi.ts",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "api:migrate:dev": "turbo run api:migrate:dev",
    "api:generate": "turbo run api:generate",
    "api:client:generate": "pnpm openapi:generate && pnpm openapi:check && tsx ./scripts/sanitize-openapi.ts && orval --config ./orval.config.ts",
    "api:studio": "turbo run api:studio",
    "battlelog:migrate": "turbo run battlelog:migrate",
    "battlelog:migrate:init": "turbo run battlelog:migrate:init",
    "battlelog:migrate:dev": "turbo run battlelog:migrate:dev",
    "battlelog:generate": "turbo run battlelog:generate",
    "battlelog:studio": "turbo run battlelog:studio",
    "activity:migrate:dev": "turbo run activity:migrate:dev",
    "activity:generate": "turbo run activity:generate",
    "activity:studio": "turbo run activity:studio",
    "auth:migrate:dev": "turbo run auth:migrate:dev",
    "auth:migrate:prod": "turbo run auth:migrate:prod",
    "env:generate": "turbo run env:generate",
    "seed": "tsx packages/cli/src/index.ts seed",
    "seed:setup": "tsx packages/cli/src/index.ts seed setup",
    "seed:scrape": "tsx packages/cli/src/index.ts seed scrape:all",
    "seed:scrape:items": "tsx packages/cli/src/index.ts seed scrape:items",
    "seed:scrape:npcs": "tsx packages/cli/src/index.ts seed scrape:npcs",
    "seed:generate:players": "tsx packages/cli/src/index.ts seed generate:players",
    "events": "tsx packages/cli/src/index.ts events",
    "events:publish": "tsx packages/cli/src/index.ts events publish",
    "build:game-client": "turbo run build:game-client",
    "copy-entrypoint": "turbo run copy-entrypoint",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "turbo build && changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@lootlog/typescript-config": "workspace:*",
    "husky": "^9.1.7",
    "knip": "^6.14.1",
    "lint-staged": "^16.4.0",
    "orval": "^8.11.0",
    "oxfmt": "^0.50.0",
    "oxlint": "^1.65.0",
    "tsx": "^4.22.2",
    "turbo": "^2.9.14",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "overrides": {
      "react-hook-form": "7.67.0",
      "discord-api-types": "0.38.31",
      "multer": "^2.0.1",
      "cross-spawn": "^7.0.5",
      "body-parser": "^1.20.3",
      "undici": "^6.24.0",
      "js-yaml@<3.14.2": ">=3.14.2",
      "js-yaml@>=4.0.0 <4.1.1": ">=4.1.1",
      "glob": "^13.0.0",
      "valibot@>=0.31.0 <1.2.0": ">=1.2.0",
      "express@>=5.0.0 <5.2.0": ">=5.2.0",
      "better-auth@<1.4.2": ">=1.4.2",
      "react-router@>=7.0.0 <=7.11.0": ">=7.12.0",
      "react-router@>=7.0.0 <7.12.0": ">=7.12.0",
      "react-router@>=7.0.0 <7.9.6": ">=7.9.6",
      "lodash@>=4.0.0 <=4.17.22": ">=4.17.23",
      "hono@<4.11.7": ">=4.11.7",
      "hono@<4.11.10": ">=4.11.10",
      "minimatch@<3.1.3": ">=3.1.3",
      "minimatch@<3.1.4": ">=3.1.4",
      "ajv@>=7.0.0-alpha.0 <8.18.0": ">=8.18.0",
      "hono@<4.12.4": ">=4.12.4",
      "fastify@>=5.7.2 <=5.8.0": ">=5.8.1",
      "@hono/node-server@<1.19.10": ">=1.19.10",
      "file-type@>=13.0.0 <21.3.1": ">=21.3.1",
      "hono@<4.12.7": ">=4.12.7",
      "yauzl@<3.2.1": ">=3.2.1",
      "file-type@>=20.0.0 <=21.3.1": ">=21.3.2",
      "esbuild@<=0.26.0": ">=0.27.0",
      "flatted@<=3.4.1": ">=3.4.2",
      "fast-xml-parser@>=4.0.0-beta.3 <=5.5.6": ">=5.5.7",
      "effect@<3.20.0": ">=3.20.0",
      "fast-xml-parser@>=4.0.0-beta.3 <=5.5.5": ">=5.5.6",
      "socket.io-parser@>=4.0.0 <4.2.6": ">=4.2.6",
      "h3@>=2.0.0-beta.0 <=2.0.1-rc.16": ">=2.0.1-rc.17",
      "h3@>=2.0.0-beta.4 <2.0.1-rc.18": ">=2.0.1-rc.18",
      "fastify@<=5.8.2": ">=5.8.3",
      "smol-toml@<1.6.1": ">=1.6.1",
      "h3@>=2.0.1-alpha.0 <=2.0.1-rc.16": ">=2.0.1-rc.17",
      "handlebars@>=4.0.0 <=4.7.8": ">=4.7.9",
      "brace-expansion@>=2.0.0 <2.0.3": ">=2.0.3",
      "brace-expansion@>=4.0.0 <5.0.5": ">=5.0.5",
      "handlebars@>=4.0.0 <4.7.9": ">=4.7.9",
      "picomatch@<2.3.2": ">=2.3.2",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4",
      "path-to-regexp@>=8.0.0 <8.4.0": ">=8.4.0",
      "handlebars@>=4.6.0 <=4.7.8": ">=4.7.9",
      "happy-dom@<20.8.9": ">=20.8.9",
      "happy-dom@>=15.10.0 <=20.8.7": ">=20.8.8",
      "lodash@>=4.0.0 <=4.17.23": ">=4.18.0",
      "lodash@<=4.17.23": ">=4.18.0",
      "defu@<=6.1.4": ">=6.1.5",
      "@hono/node-server@<1.19.13": ">=1.19.13",
      "fastify@>=5.3.2 <=5.8.4": ">=5.8.5"
    },
    "packageExtensions": {
      "@hookform/resolvers": {
        "peerDependencies": {
          "zod": "*"
        }
      }
    },
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "@scarf/scarf",
      "@swc/core",
      "@tailwindcss/oxide",
      "core-js-pure",
      "cpu-features",
      "esbuild",
      "msgpackr-extract",
      "rolldown",
      "necord",
      "prisma",
      "protobufjs",
      "sharp",
      "ssh2",
      "unrs-resolver",
      "workerd"
    ]
  }
}
